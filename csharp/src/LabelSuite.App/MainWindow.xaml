<Window x:Class="LabelSuite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LabelSuite.App.Views"
        Title="LabelSuite — 통합 라벨 검사" Width="1600" Height="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Malgun Gothic, Segoe UI" FontSize="13">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
                   BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="준비됨"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="AwsStatusText" Text="AWS: 미확인"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <TabControl x:Name="Tabs" Margin="8,4,8,4">
                <TabItem Header="목록 생성">
                    <views:GeneratorView x:Name="Generator"/>
                </TabItem>
                <TabItem Header="라벨 검사">
                    <views:InspectorView x:Name="Inspector"/>
                </TabItem>
                <TabItem Header="검사 이력">
                    <views:HistoryView x:Name="HistoryPage"/>
                </TabItem>
            </TabControl>
            <Button Content="설정" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,6,16,0" Padding="14,6" Click="OnOpenSettings"/>
        </Grid>
    </DockPanel>
</Window>
