<Window x:Class="LabelSuite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LabelSuite.App.Views"
        Title="LabelSuite — 라벨 검사 Suite" Height="880" Width="1500"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- ===================== 상태바 (verifier 스타일) ===================== -->
        <StatusBar DockPanel.Dock="Bottom" Height="30">
            <StatusBarItem>
                <TextBlock x:Name="AwsStatusText" Text="AWS: 확인 중..." FontWeight="Bold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock x:Name="StatusText" Text="준비"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <Button Content="설정" Padding="14,2" Margin="0" Click="OnOpenSettings"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="Tabs">
            <TabItem Header="  목록 생성  ">
                <views:GeneratorView x:Name="Generator"/>
            </TabItem>
            <TabItem Header="  라벨 검사  ">
                <views:InspectorView x:Name="Inspector"/>
            </TabItem>
            <TabItem Header="  검사 이력  ">
                <views:HistoryView x:Name="HistoryPage"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
