<Window x:Class="LabelSuite.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LaVIS 설정" Width="860" Height="680" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <!-- 하단 바(UDInspect 규범): 안내문 왼쪽, 저장(파랑)·취소 오른쪽 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="취소" Click="OnCancel" Padding="18,5" Margin="8,0,0,0" IsCancel="True"/>
            <Button DockPanel.Dock="Right" Content="저장" Click="OnSave" MinWidth="90"
                    Style="{StaticResource PrimaryButton}" Padding="18,5"/>
            <Button DockPanel.Dock="Left" Content="설정 폴더 열기" Click="OnOpenConfigFolder"
                    ToolTip="settings.json · standards.json · 학습 데이터가 있는 폴더를 탐색기로 엽니다"/>
            <TextBlock x:Name="SettingsNote" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource HintText}"
                       Text="저장하면 즉시 적용되고 다음 실행에도 유지됩니다."/>
        </DockPanel>

        <TabControl x:Name="SettingsTabs">
            <TabItem Header="  일반 · 저장 · AWS  "
                     ToolTip="결과 저장 경로 · 유효기간 · OCR 프리페치 / 결과 이미지 배율·품질 / AWS 리전·프로필 인증">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <GroupBox Header="일반 (결과 저장 경로 · 유효기간 · OCR 프리페치)">
                        <StackPanel>
                            <TextBlock Text="결과 저장 경로 (재실행 시에도 유지됩니다)"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="찾아보기"
                                        Click="OnBrowseSaveDir"/>
                                <TextBox x:Name="SaveDirBox" Tag="save_directory"/>
                            </DockPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Text="유효기간(개월):" VerticalAlignment="Center"/>
                                <TextBox x:Name="ShelfLifeBox" Tag="shelf_life_months" Width="60"/>
                                <TextBlock Text="   OCR 프리페치:" VerticalAlignment="Center"/>
                                <ComboBox x:Name="PrefetchCombo" Width="130">
                                    <ComboBoxItem Content="전체 페이지"/>
                                    <ComboBoxItem Content="1페이지 앞"/>
                                    <ComboBoxItem Content="2페이지 앞"/>
                                    <ComboBoxItem Content="5페이지 앞"/>
                                    <ComboBoxItem Content="프리페치 없음"/>
                                </ComboBox>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="유효기간: EXP = MFG + 기간 - 1일"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="결과 이미지 저장 (파일명 ###_LOT_REF_날짜_판정.jpg · 자동 저장 기본값)">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="저장 이미지 배율:" VerticalAlignment="Center"/>
                                <TextBox x:Name="SaveScaleBox" Tag="save_scale" Width="46"/>
                                <TextBlock Text="   저장 JPEG 품질:" VerticalAlignment="Center"/>
                                <TextBox x:Name="SaveJpegQualityBox" Tag="jpeg_quality" Width="46"/>
                                <CheckBox x:Name="AutoSaveDefaultCheck" Content="자동 저장 기본 켜기"
                                          Margin="16,2,0,2"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="배율 0.5 = 원본의 50% 크기로 저장 (용량 절약). 파일명: ###_LOT_REF_날짜_판정.jpg"/>
                            <CheckBox x:Name="CsvTextProtectCheck" Margin="0,6,0,0"
                                      Content="엑셀 숫자 변환 방지 (CSV 내보내기 시 LOT·GTIN 등을 =&quot;값&quot; 으로 래핑)"
                                      ToolTip="켜면 CSV를 엑셀로 열어도 LOT 앞자리 0과 GTIN 14자리가 유지됩니다. 외부 도구(pandas 등)로 읽을 때는 =&quot;…&quot; 래핑을 벗겨야 하므로 끌 수 있습니다"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="AWS Textract (OCR 엔진이 AWS일 때만 사용)">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="리전:" VerticalAlignment="Center"/>
                                <TextBox x:Name="AwsRegionBox" Width="150"/>
                                <TextBlock Text="   프로필:" VerticalAlignment="Center"/>
                                <TextBox x:Name="AwsProfileBox" Width="130"
                                         ToolTip="비우면 기본 자격증명 체인을 사용합니다"/>
                                <Button Content="인증 확인" Style="{StaticResource AccentButton}" Click="OnCheckAws"/>
                            </WrapPanel>
                            <TextBlock x:Name="AwsCheckLabel" TextWrapping="Wrap" Margin="2,4,2,0"/>
                        </StackPanel>
                    </GroupBox>
                        <TextBlock Style="{StaticResource HintText}" Margin="6,2"
                                   Text="고급 설정(컬럼 매핑 · 중국 REF 매핑 · 규격 표시명)은 [설정 폴더 열기]에서 JSON 파일을 직접 편집합니다."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="  OCR 엔진 · 교정  "
                     ToolTip="엔진 선택(AWS/패턴/ONNX), 전송·신뢰도 설정, 교정 사전·병합 규칙">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <GroupBox Header="OCR 설정 (엔진 선택 · 전송 크기 · 신뢰도 알람)">
                        <StackPanel>
                            <!-- 파괴적 버튼은 우측 끝에 분리 (UDInspect 규범: 빨강은 멀리) -->
                            <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="패턴 초기화" Click="OnClearGlyphs"
                                        Style="{StaticResource DangerButton}" Margin="24,0,0,0"
                                        ToolTip="학습된 글자 패턴을 모두 삭제합니다 (되돌릴 수 없음 · [취소]로도 복구되지 않음 — 확인 대화상자가 표시됩니다)"/>
                                <WrapPanel>
                                    <TextBlock Text="OCR 엔진:" VerticalAlignment="Center"
                                               FontWeight="Bold"/>
                                    <ComboBox x:Name="OcrEngineCombo" Width="200" Margin="6,0">
                                        <ComboBoxItem Content="AWS Textract (클라우드)"/>
                                        <ComboBoxItem Content="패턴 학습 (로컬·무료)"/>
                                        <ComboBoxItem Content="ONNX RapidOCR (로컬·무료)"/>
                                    </ComboBox>
                                    <TextBlock x:Name="GlyphStatusText" VerticalAlignment="Center"
                                               Margin="10,0,6,0" Foreground="{StaticResource MutedBrush}"/>
                                </WrapPanel>
                            </DockPanel>
                            <WrapPanel Margin="0,0,0,4">
                                <Button Content="학습 데이터 내보내기" Click="OnExportLearning"
                                        ToolTip="글자 패턴 + 교정 사전을 파일 하나로 내보냅니다 (다른 PC 이식용)"/>
                                <Button Content="학습 데이터 가져오기" Click="OnImportLearning" Style="{StaticResource CautionButton}"
                                        ToolTip="다른 PC에서 내보낸 학습 데이터를 현재 데이터에 병합합니다 (가져오는 즉시 반영되며 [취소]로 되돌릴 수 없음)"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource HintText}"
                                       Margin="0,0,0,6"
                                       Text="패턴 학습: AWS로 검사할 때 글자 모양을 자동 학습 → 이후 무료·오프라인·초고속 인식. ONNX: 학습 없이 바로 쓰는 범용 로컬 OCR."/>
                            <WrapPanel>
                                <TextBlock Text="PDF 렌더 배율:" VerticalAlignment="Center"/>
                                <TextBox x:Name="RenderZoomBox" Tag="pdf_render_zoom" Width="50"/>
                                <TextBlock Text="   전송 최대 크기(px):" VerticalAlignment="Center"/>
                                <TextBox x:Name="OcrMaxDimBox" Tag="ocr.max_dimension" Width="60"/>
                                <TextBlock Text="   전송 JPEG 품질:" VerticalAlignment="Center"/>
                                <TextBox x:Name="OcrJpegQualityBox" Tag="ocr.jpeg_quality" Width="46"/>
                                <TextBlock Text="   최소 신뢰도(%):" VerticalAlignment="Center"/>
                                <TextBox x:Name="OcrMinConfBox" Tag="ocr.min_confidence" Width="46"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <CheckBox x:Name="ContrastStretchCheck"
                                          Content="이미지 대비 보정 (저대비·흐린 인쇄 대응)"/>
                                <CheckBox x:Name="ConfusablesCheck" Margin="16,2,0,2"
                                          Content="혼동 문자 허용 매칭 (O↔0, I↔1 등)"/>
                                <CheckBox x:Name="CropLabelCheck" Margin="16,2,0,2"
                                          Content="라벨 정렬 (하늘색 이형지 기준 크롭 + 기울기 보정)"
                                          ToolTip="이형지 바깥 흰 배경을 잘라내고 기울기를 보정해 라벨 위치·크기·각도를 일정하게 맞춥니다"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <CheckBox x:Name="QualityAlarmCheck"
                                          Content="저신뢰 OCR 알람 (해당 단어 주황 하이라이트)"/>
                                <TextBlock Text="   단어 임계(%):" VerticalAlignment="Center"/>
                                <TextBox x:Name="LowWordConfBox" Tag="ocr.low_word_confidence" Width="46"/>
                                <TextBlock Text="   평균 임계(%):" VerticalAlignment="Center"/>
                                <TextBox x:Name="LowAvgConfBox" Tag="ocr.low_avg_confidence" Width="46"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="페이지 평균 신뢰도가 평균 임계 미만이거나, 단어 임계 미만인 단어가 30%를 넘으면 배지·상태바에 알람을 띄우고 해당 단어를 주황 파선 박스로 표시합니다."/>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="렌더 배율↑·전송 크기↑ = 정밀·느림 / 최소 신뢰도: 이 값 미만 OCR 단어는 무시 (0=전부 사용)"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="OCR 교정 사전 (오인식 → 올바른 값, 자동 학습 포함)">
                        <StackPanel>
                            <DataGrid x:Name="CorrectionsGrid" IsReadOnly="False"
                                      AutoGenerateColumns="False" CanUserAddRows="True"
                                      Height="110" FontFamily="Consolas">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="잘못 읽힌 값" Binding="{Binding Wrong}" Width="*"/>
                                    <DataGridTextColumn Header="올바른 값" Binding="{Binding Right}" Width="*"/>
                                    <DataGridTextColumn Header="필드" Binding="{Binding Field}" Width="90"/>
                                    <DataGridTextColumn Header="등록일" Binding="{Binding LearnedAt}"
                                                        IsReadOnly="True" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="검사 탭에서 필드 행을 더블클릭해도 등록할 수 있습니다. 같은 길이의 교정에서 문자 혼동 규칙(예: O↔0)을 자동 학습합니다."/>
                            <TextBlock Text="단어 병합 패턴 (OCR 로그에서 여러 단어 선택 → [선택 병합 학습]으로 등록):"
                                       Margin="0,8,0,2"/>
                            <DataGrid x:Name="MergesGrid" IsReadOnly="False"
                                      AutoGenerateColumns="False" CanUserAddRows="True"
                                      Height="80" FontFamily="Consolas">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="병합할 단어들 (공백 구분 — 순서대로 나란히 나오면 한 문장으로 인식)"
                                                        Binding="{Binding Pattern}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="  검출 필드 · 영역  "
                     ToolTip="검사 대상 필드 켜기/끄기, 커스텀 필드, 필드 검출 영역·문자 제약·동일값 패턴, 라벨 유형 학습">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <GroupBox Header="OCR 대상 필드 (기본 6종 LOT/PN/REF/MFG DATE/EXP DATE/GTIN — LOT은 끌 수 없음)">
                        <StackPanel>
                            <TextBlock Text="검사에서 제외할 내장 필드 (LOT은 매칭 기준이라 제외 불가):"
                                       Margin="0,0,0,2"/>
                            <WrapPanel x:Name="DisabledFieldsPanel"/>
                            <TextBlock Text="커스텀 필드 (라벨에서 추가로 찾을 값):" Margin="0,8,0,2"/>
                            <DataGrid x:Name="CustomFieldsGrid" IsReadOnly="False"
                                      AutoGenerateColumns="False" CanUserAddRows="True"
                                      Height="110" FontFamily="Consolas">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="110"/>
                                    <DataGridTextColumn Header="패턴 (고정 텍스트 또는 정규식)"
                                                        Binding="{Binding Pattern}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="정규식" Binding="{Binding IsRegex}" Width="54"/>
                                    <DataGridTextColumn Header="기대횟수" Binding="{Binding Expected}" Width="64"/>
                                    <DataGridTextColumn Header="규격 자동" Binding="{Binding Standard}" Width="66"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="예: 이름=CE마크, 패턴=CE0123 / 기대횟수를 비우면 판정에 반영하지 않고 검출 수만 표시합니다. '규격 자동'에 규격 키(MDR/MDD/BSC/A00/A02/중국)를 넣으면 이 값이 라벨에서 검출될 때 그 규격이 자동 선택됩니다 (예: 패턴 Rev.A00 → 규격 A00). 수동으로 규격 버튼을 누르면 그 페이지는 수동 선택이 우선합니다."/>
                            <TextBlock Text="필드 검출 영역 (등록 필드는 영역 안 검출만 인정 — 검사 화면 [필드 영역 등록] 버튼으로 드래그/클릭 등록):"
                                       Margin="0,8,0,2"/>
                            <DataGrid x:Name="ZonesGrid" IsReadOnly="False"
                                      AutoGenerateColumns="False" CanUserAddRows="True"
                                      Height="100" FontFamily="Consolas">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="필드" Binding="{Binding Field}" Width="110"/>
                                    <DataGridTextColumn Header="규격(비우면 전체)" Binding="{Binding Standard}" Width="110"/>
                                    <DataGridTextColumn Header="X%" Binding="{Binding X}" Width="52"/>
                                    <DataGridTextColumn Header="Y%" Binding="{Binding Y}" Width="52"/>
                                    <DataGridTextColumn Header="W%" Binding="{Binding W}" Width="52"/>
                                    <DataGridTextColumn Header="H%" Binding="{Binding H}" Width="52"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="영역이 등록된 필드는 라벨의 다른 위치에서 우연히 매칭되는 값을 바운딩 박스/판정에서 제외합니다 (±4% 이동 허용). 행을 지우면 영역 제한이 해제됩니다."/>
                            <TextBlock Text="필드별 문자 제약 (이 필드에서 나올 수 없는 문자를 미리 지정):"
                                       Margin="0,8,0,2"/>
                            <DataGrid x:Name="CharsetsGrid" IsReadOnly="False"
                                      AutoGenerateColumns="False" CanUserAddRows="True"
                                      Height="150" FontFamily="Consolas">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="필드" Binding="{Binding Field}" Width="110"/>
                                    <DataGridTextColumn Header="허용 문자 (이 문자만 가능)"
                                                        Binding="{Binding Allowed}" Width="*"/>
                                    <DataGridTextColumn Header="금지 문자 (나올 수 없음)"
                                                        Binding="{Binding Denied}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="예: LOT 허용=0123456789 → OCR이 O를 읽으면 자동으로 0으로 복원 (O↔0, I↔1, S↔5 등 혼동 그룹 기준). 복원 불가능한 문자는 불일치로 검출됩니다. 두 칸 모두 비우면 제약 없음."/>
                            <TextBlock Text="동일값 패턴 (라벨 안 여러 위치의 같은 값 상호 비교 — 위치 이동 자동 추적):"
                                       Margin="0,8,0,2"/>
                            <DataGrid x:Name="SameValueGrid" IsReadOnly="False"
                                      AutoGenerateColumns="False" CanUserAddRows="True"
                                      Height="100" FontFamily="Consolas">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="110"/>
                                    <DataGridTextColumn Header="패턴 (정규식)" Binding="{Binding Pattern}" Width="*"/>
                                    <DataGridTextColumn Header="최소 개수" Binding="{Binding Min}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="예: 이름=LOT 3회, 패턴=^\d{8}$, 최소 개수=3 → 8자리 숫자 객체를 전부 찾아 서로 값이 같은지 비교하고, 합격 라벨의 배치를 기준으로 학습해 다음 라벨부터는 스캔·출력 위치 이동을 보정한 뒤 기준 위치마다 값이 있는지 추적합니다. 결과는 검사 탭 바코드 검증 표에 '동일값' 행으로 표시됩니다."/>
                            <WrapPanel Margin="0,8,0,0">
                                <CheckBox x:Name="TypeLearningCheck"
                                          Content="라벨 유형 학습·이상 알람"/>
                                <TextBlock Text="   판정 시작 표본 수:" VerticalAlignment="Center"/>
                                <TextBox x:Name="TypeMinSamplesBox" Tag="type_learning.min_samples" Width="46"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="검사할 때마다 라벨 전체 OCR 문구를 유형(PN+규격)별로 축적하고, 표본이 쌓인 뒤 기존 유형과 다른 라벨(고정 문구 누락·처음 보는 문구 다수)이 나오면 알람을 띄웁니다."/>
                        </StackPanel>
                    </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="  규격 · 양식 감지  "
                     ToolTip="프리셋 내보내기/가져오기 · 데이터 백업, 규격별 기대 출현 횟수, 라벨 양식 자동 감지 규칙">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <GroupBox Header="프리셋 (규격 + 필드 규칙 + 영역 + 양식 감지 + 학습 데이터를 한 파일로)">
                        <StackPanel>
                            <WrapPanel>
                                <Button Content="프리셋 내보내기…" Style="{StaticResource PrimaryButton}" Click="OnExportPreset"
                                        ToolTip="현재 규격·필드 규칙·영역·양식 감지·컬럼 매핑·학습 데이터(글자 패턴/교정/병합/동일값 레이아웃/양식 템플릿/유형 프로필)를 .lavispreset 파일 하나로 내보냅니다.&#10;다른 PC나 다른 제품군 세팅으로 전환할 때 사용합니다"/>
                                <Button Content="프리셋 가져오기…" Click="OnImportPreset" Style="{StaticResource CautionButton}"
                                        ToolTip="프리셋 파일을 적용합니다. 현재 규칙·학습 데이터는 교체되며(가져오기 전 backup-preset-시각 폴더에 보관) 적용을 위해 프로그램이 다시 시작됩니다.&#10;PC 고유 설정(저장 폴더·AWS·OCR 엔진 선택)은 유지됩니다"/>
                                <Button Content="데이터 폴더 백업…" Click="OnBackupDataDir"
                                        ToolTip="설정·규격·학습 데이터·이력 DB가 있는 데이터 폴더 전체를 zip으로 보관합니다"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="프리셋 = 제품군/라인별 검사 세팅 단위. 학습 데이터만 옮기려면 [OCR 엔진·교정] 탭의 학습 데이터 내보내기(.lslearn)를 쓰세요. 프리셋에는 저장 폴더·AWS 프로필·최근 파일 같은 PC 고유값은 들어가지 않습니다."/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="검사 기준 (규격별 기대 출현 횟수 — 더블클릭 수정, 0 = 검사 안 함)">
                        <DataGrid x:Name="CountsGrid" IsReadOnly="False"
                                  AutoGenerateColumns="True" CanUserAddRows="False"
                                  Height="200"/>
                    </GroupBox>
                    <GroupBox Header="라벨 양식 자동 감지 (양식명 위치·패턴으로 라벨 종류 판별)">
                        <StackPanel>
                            <DataGrid x:Name="FormRulesGrid" IsReadOnly="False"
                                      AutoGenerateColumns="False" CanUserAddRows="True"
                                      Height="120" FontFamily="Consolas">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="양식명" Binding="{Binding Name}" Width="100"/>
                                    <DataGridTextColumn Header="규격" Binding="{Binding Standard}" Width="60"/>
                                    <DataGridTextColumn Header="X%" Binding="{Binding X}" Width="44"/>
                                    <DataGridTextColumn Header="Y%" Binding="{Binding Y}" Width="44"/>
                                    <DataGridTextColumn Header="W%" Binding="{Binding W}" Width="44"/>
                                    <DataGridTextColumn Header="H%" Binding="{Binding H}" Width="44"/>
                                    <DataGridTextColumn Header="텍스트 패턴 (정규식)" Binding="{Binding Pattern}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="이미지" Binding="{Binding UseImage}" Width="52"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="라벨마다 특정 위치에 인쇄되는 양식명(예: Rev.A00)으로 라벨 종류를 자동 감지해 규격을 선택합니다. 영역은 페이지 비율(%): X,Y=좌상단, W,H=크기. 텍스트 패턴(예: Rev\.?A00)과 이미지 중 하나만 설정해도 되고 둘 다 설정하면 어느 한쪽만 맞아도 감지됩니다(둘 다 맞으면 신뢰도 상승). 이미지 기준은 검사 탭에서 해당 양식 라벨을 띄우고 [양식 학습] 버튼으로 등록합니다. 규격 칸에는 내부 키(MDR/MDD/BSC/A00/A02/중국)를 입력하세요."/>
                        </StackPanel>
                    </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="  표시  "
                     ToolTip="바운딩 박스 두께·투명도·번호, 필드별 색상 (저장 이미지·화면 공통)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <GroupBox Header="바운딩 박스 표시 (저장 이미지·화면 공통)">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="테두리 두께:" VerticalAlignment="Center"/>
                                <TextBox x:Name="OverlayThicknessBox" Tag="overlay.thickness" Width="40"/>
                                <TextBlock Text="   채움 투명도(0~255):" VerticalAlignment="Center"/>
                                <TextBox x:Name="OverlayAlphaBox" Tag="overlay.fill_alpha" Width="46"/>
                                <CheckBox x:Name="OverlayNumbersCheck" Content="번호 표시"
                                          Margin="16,2,0,2"/>
                            </WrapPanel>
                            <TextBlock Text="필드별 색상 (R,G,B 0~255):" Margin="0,6,0,2"/>
                            <DataGrid x:Name="FieldColorsGrid" IsReadOnly="False"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      Height="150" FontFamily="Consolas">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="필드" Binding="{Binding Field}"
                                                        IsReadOnly="True" Width="110"/>
                                    <DataGridTextColumn Header="R" Binding="{Binding R}" Width="52"/>
                                    <DataGridTextColumn Header="G" Binding="{Binding G}" Width="52"/>
                                    <DataGridTextColumn Header="B" Binding="{Binding B}" Width="52"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
