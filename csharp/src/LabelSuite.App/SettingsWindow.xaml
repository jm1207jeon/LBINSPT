<Window x:Class="LabelSuite.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Width="720" Height="720"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="4">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="4,6">
            <Button Content="설정 폴더 열기" Click="OnOpenConfigFolder"/>
            <Button Content="설정 저장" FontWeight="Bold" MinWidth="90" Click="OnSave"/>
            <Button Content="취소" MinWidth="70" Click="OnCancel"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="일반">
                    <StackPanel>
                        <TextBlock Text="결과 저장 경로 (재실행 시에도 유지됩니다)"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="찾아보기"
                                    Click="OnBrowseSaveDir"/>
                            <TextBox x:Name="SaveDirBox"/>
                        </DockPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="유효기간(개월):" VerticalAlignment="Center"/>
                            <TextBox x:Name="ShelfLifeBox" Width="60"/>
                            <TextBlock Text="   OCR 프리페치:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PrefetchCombo" Width="130">
                                <ComboBoxItem Content="전체 페이지"/>
                                <ComboBoxItem Content="1페이지 앞"/>
                                <ComboBoxItem Content="2페이지 앞"/>
                                <ComboBoxItem Content="5페이지 앞"/>
                                <ComboBoxItem Content="프리페치 없음"/>
                            </ComboBox>
                        </WrapPanel>
                        <TextBlock FontSize="11" Foreground="Gray"
                                   Text="유효기간: EXP = MFG + 기간 - 1일"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="OCR 설정 (인식 정밀도 / 속도)">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,4">
                            <TextBlock Text="OCR 엔진:" VerticalAlignment="Center"
                                       FontWeight="Bold"/>
                            <ComboBox x:Name="OcrEngineCombo" Width="200" Margin="6,0">
                                <ComboBoxItem Content="AWS Textract (클라우드)"/>
                                <ComboBoxItem Content="패턴 학습 (로컬·무료)"/>
                                <ComboBoxItem Content="ONNX RapidOCR (로컬·무료)"/>
                            </ComboBox>
                            <TextBlock x:Name="GlyphStatusText" VerticalAlignment="Center"
                                       Margin="10,0,6,0" Foreground="Gray"/>
                            <Button Content="패턴 초기화" Click="OnClearGlyphs"
                                    ToolTip="학습된 글자 패턴을 모두 삭제합니다"/>
                        </WrapPanel>
                        <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                                   Margin="0,0,0,6"
                                   Text="패턴 학습: AWS로 검사할 때 글자 모양을 자동 학습 → 이후 무료·오프라인·초고속 인식. ONNX: 학습 없이 바로 쓰는 범용 로컬 OCR."/>
                        <WrapPanel>
                            <TextBlock Text="PDF 렌더 배율:" VerticalAlignment="Center"/>
                            <TextBox x:Name="RenderZoomBox" Width="50"/>
                            <TextBlock Text="   전송 최대 크기(px):" VerticalAlignment="Center"/>
                            <TextBox x:Name="OcrMaxDimBox" Width="60"/>
                            <TextBlock Text="   전송 JPEG 품질:" VerticalAlignment="Center"/>
                            <TextBox x:Name="OcrJpegQualityBox" Width="46"/>
                            <TextBlock Text="   최소 신뢰도(%):" VerticalAlignment="Center"/>
                            <TextBox x:Name="OcrMinConfBox" Width="46"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,4,0,0">
                            <CheckBox x:Name="ContrastStretchCheck"
                                      Content="이미지 대비 보정 (저대비·흐린 인쇄 대응)"/>
                            <CheckBox x:Name="ConfusablesCheck" Margin="16,2,0,2"
                                      Content="혼동 문자 허용 매칭 (O↔0, I↔1 등)"/>
                        </WrapPanel>
                        <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                                   Text="렌더 배율↑·전송 크기↑ = 정밀·느림 / 최소 신뢰도: 이 값 미만 OCR 단어는 무시 (0=전부 사용)"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="OCR 대상 필드">
                    <StackPanel>
                        <TextBlock Text="검사에서 제외할 내장 필드 (LOT은 매칭 기준이라 제외 불가):"
                                   Margin="0,0,0,2"/>
                        <WrapPanel x:Name="DisabledFieldsPanel"/>
                        <TextBlock Text="커스텀 필드 (라벨에서 추가로 찾을 값):" Margin="0,8,0,2"/>
                        <DataGrid x:Name="CustomFieldsGrid" IsReadOnly="False"
                                  AutoGenerateColumns="False" CanUserAddRows="True"
                                  Height="110" FontFamily="Consolas">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="110"/>
                                <DataGridTextColumn Header="패턴 (고정 텍스트 또는 정규식)"
                                                    Binding="{Binding Pattern}" Width="*"/>
                                <DataGridCheckBoxColumn Header="정규식" Binding="{Binding IsRegex}" Width="54"/>
                                <DataGridTextColumn Header="기대횟수" Binding="{Binding Expected}" Width="64"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                                   Text="예: 이름=CE마크, 패턴=CE0123 / 기대횟수를 비우면 판정에 반영하지 않고 검출 수만 표시합니다."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="바운딩 박스 표시">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="테두리 두께:" VerticalAlignment="Center"/>
                            <TextBox x:Name="OverlayThicknessBox" Width="40"/>
                            <TextBlock Text="   채움 투명도(0~255):" VerticalAlignment="Center"/>
                            <TextBox x:Name="OverlayAlphaBox" Width="46"/>
                            <CheckBox x:Name="OverlayNumbersCheck" Content="번호 표시"
                                      Margin="16,2,0,2"/>
                        </WrapPanel>
                        <TextBlock Text="필드별 색상 (R,G,B 0~255):" Margin="0,6,0,2"/>
                        <DataGrid x:Name="FieldColorsGrid" IsReadOnly="False"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  Height="150" FontFamily="Consolas">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="필드" Binding="{Binding Field}"
                                                    IsReadOnly="True" Width="110"/>
                                <DataGridTextColumn Header="R" Binding="{Binding R}" Width="52"/>
                                <DataGridTextColumn Header="G" Binding="{Binding G}" Width="52"/>
                                <DataGridTextColumn Header="B" Binding="{Binding B}" Width="52"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="OCR 교정 사전 (오인식 → 올바른 값, 자동 학습 포함)">
                    <StackPanel>
                        <DataGrid x:Name="CorrectionsGrid" IsReadOnly="False"
                                  AutoGenerateColumns="False" CanUserAddRows="True"
                                  Height="110" FontFamily="Consolas">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="잘못 읽힌 값" Binding="{Binding Wrong}" Width="*"/>
                                <DataGridTextColumn Header="올바른 값" Binding="{Binding Right}" Width="*"/>
                                <DataGridTextColumn Header="필드" Binding="{Binding Field}" Width="90"/>
                                <DataGridTextColumn Header="등록일" Binding="{Binding LearnedAt}"
                                                    IsReadOnly="True" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                                   Text="검사 탭에서 필드 행을 더블클릭해도 등록할 수 있습니다. 같은 길이의 교정에서 문자 혼동 규칙(예: O↔0)을 자동 학습합니다."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="AWS Textract">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="리전:" VerticalAlignment="Center"/>
                            <TextBox x:Name="AwsRegionBox" Width="150"/>
                            <TextBlock Text="   프로필:" VerticalAlignment="Center"/>
                            <TextBox x:Name="AwsProfileBox" Width="130"
                                     ToolTip="비우면 기본 자격증명 체인을 사용합니다"/>
                            <Button Content="인증 확인" FontWeight="Bold" Click="OnCheckAws"/>
                        </WrapPanel>
                        <TextBlock x:Name="AwsCheckLabel" TextWrapping="Wrap" Margin="2,4,2,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="검사 기준 (규격별 필드 기대 출현 횟수 — 더블클릭으로 수정)">
                    <DataGrid x:Name="CountsGrid" IsReadOnly="False"
                              AutoGenerateColumns="True" CanUserAddRows="False"
                              Height="200"/>
                </GroupBox>

                <GroupBox Header="결과/사진 저장">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="저장 이미지 배율:" VerticalAlignment="Center"/>
                            <TextBox x:Name="SaveScaleBox" Width="46"/>
                            <TextBlock Text="   저장 JPEG 품질:" VerticalAlignment="Center"/>
                            <TextBox x:Name="SaveJpegQualityBox" Width="46"/>
                            <CheckBox x:Name="AutoSaveDefaultCheck" Content="자동 저장 기본 켜기"
                                      Margin="16,2,0,2"/>
                        </WrapPanel>
                        <TextBlock FontSize="11" Foreground="Gray"
                                   Text="배율 0.5 = 원본의 50% 크기로 저장 (용량 절약). 파일명: ###_LOT_REF_날짜_판정.jpg"/>
                    </StackPanel>
                </GroupBox>

                <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="6,2"
                           Text="고급 설정(컬럼 매핑 · 중국 REF 매핑 · 규격 표시명)은 [설정 폴더 열기]에서 JSON 파일을 직접 편집합니다."/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
