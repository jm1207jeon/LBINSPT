<Window x:Class="LabelSuite.App.ResultListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="검사 결과 목록" Width="860" Height="520" MinWidth="680" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- 비모달 창: 검사 화면 옆에 띄워 두고 부적합 행을 클릭 → 해당 페이지로 이동 → 문제 해결(LOT 수동·교정·영역·재검사)
         → 자동 판정이 여전히 '확인 필요'면 검사자가 육안 확인 후 [합격 처리]. 자동 판정은 보존되고 최종 판정만 바뀐다 -->
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontWeight="Bold"
                       FontSize="{StaticResource SubCountSize}" Foreground="{StaticResource AccentBrush}"/>
            <CheckBox x:Name="FailOnlyCheck" DockPanel.Dock="Right" Content="부적합만 보기" IsChecked="True"
                      VerticalAlignment="Center" Checked="OnFilterChanged" Unchecked="OnFilterChanged"
                      ToolTip="자동 판정 '확인 필요'·LOT 미매칭 페이지만 표시 (검사자 확인 합격 처리된 페이지는 제외)"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource HintText}" VerticalAlignment="Center"
                       Text="행 더블클릭 = 해당 페이지로 이동 · 합격 처리는 사유가 기록되며 CSV·이력·저장 이미지에 '검사자 확인'으로 남습니다"
                       TextWrapping="Wrap" MaxWidth="440"/>
            <Button DockPanel.Dock="Right" Content="닫기" Click="OnClose" IsCancel="True" Padding="14,5" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" x:Name="ClearOverrideButton" Content="합격 처리 취소" Click="OnClearOverride"
                    Padding="12,5" Margin="8,0,0,0" IsEnabled="False"
                    ToolTip="선택한 페이지의 검사자 확인 합격을 되돌립니다 (자동 판정으로 복귀)"/>
            <Button DockPanel.Dock="Right" x:Name="OverrideButton" Content="합격 처리 (검사자 확인)…" Click="OnOverride"
                    Style="{StaticResource CautionButton}" Padding="12,5" Margin="8,0,0,0" IsEnabled="False"
                    ToolTip="선택한 부적합 페이지를 육안 확인 후 합격으로 확정합니다 — 사유 입력 필수"/>
            <Button DockPanel.Dock="Right" x:Name="GoButton" Content="이 페이지로 이동" Click="OnGo"
                    Style="{StaticResource PrimaryButton}" Padding="12,5" IsEnabled="False" IsDefault="True"/>
        </DockPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnRowDoubleClick"
                  AutomationProperties.Name="검사 결과 목록">
            <DataGrid.Columns>
                <DataGridTextColumn Header="페이지" Binding="{Binding PageDisplay}" Width="56"
                                    ElementStyle="{StaticResource RightCell}"/>
                <DataGridTextColumn Header="LOT" Binding="{Binding Lot}" Width="110"/>
                <DataGridTextColumn Header="REF" Binding="{Binding Ref}" Width="120"/>
                <DataGridTextColumn Header="규격" Binding="{Binding Standard}" Width="110"/>
                <DataGridTextColumn Header="자동 판정" Binding="{Binding Auto}" Width="76"
                                    ElementStyle="{StaticResource CenterCell}"/>
                <DataGridTextColumn Header="최종" Binding="{Binding Final}" Width="118"
                                    ElementStyle="{StaticResource CenterCell}"/>
                <DataGridTextColumn Header="사유 / 비고" Binding="{Binding Reason}" Width="*"/>
                <DataGridTextColumn Header="저장" Binding="{Binding SavedMark}" Width="44"
                                    ElementStyle="{StaticResource CenterCell}"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding Reason}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tone}" Value="pass">
                            <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="override">
                            <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="fail">
                            <Setter Property="Background" Value="{StaticResource WarnBgBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </DockPanel>
</Window>
