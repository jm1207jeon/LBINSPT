<UserControl x:Class="LabelSuite.App.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
             Focusable="True" KeyDown="OnKeyDown">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 좌측: 목록/규격/결과 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="검사 목록">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="목록 열기" Click="OnOpenList"/>
                        <TextBlock x:Name="ListStatus" Grid.Column="1"
                                   Text="목록 없음 — 목록 생성 탭에서 보내거나 파일을 여세요"
                                   Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   FontWeight="Normal"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="LOT" VerticalAlignment="Center" FontWeight="Normal"/>
                        <ComboBox x:Name="LotCombo" Grid.Column="1"
                                  SelectionChanged="OnLotChanged"/>
                        <TextBlock x:Name="LotMatchLabel" Grid.Column="2" Margin="6,0,0,0"
                                   Foreground="{StaticResource SuccessBrush}"
                                   VerticalAlignment="Center" FontWeight="Normal"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="규격" VerticalAlignment="Top" Margin="0,8,0,0"
                                   FontWeight="Normal"/>
                        <WrapPanel x:Name="StandardPanel" Grid.Column="1"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="검색" VerticalAlignment="Center" FontWeight="Normal"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" KeyDown="OnSearchKeyDown"
                                 ToolTip="라벨에서 추가로 찾을 텍스트 (Enter로 적용)"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <Border Grid.Row="1" x:Name="StatusBadge" Style="{StaticResource BadgeBorder}"
                    Background="#EEF1F5" Margin="0,10,0,0">
                <TextBlock x:Name="StatusBadgeText" Text="검사 대기" FontSize="15"
                           FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
            </Border>

            <GroupBox Grid.Row="2" Header="필드별 검출" Margin="0,10,0,0">
                <DataGrid x:Name="FieldGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="필드" Binding="{Binding Field}" Width="90"/>
                        <DataGridTextColumn Header="검사 값" Binding="{Binding Term}" Width="*"/>
                        <DataGridTextColumn Header="검출/기준" Binding="{Binding Count}" Width="80"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="pass">
                                    <Setter Property="Background"
                                            Value="{StaticResource SuccessBgBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="fail">
                                    <Setter Property="Background"
                                            Value="{StaticResource WarnBgBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Row="3" Header="바코드 검증" Margin="0,10,0,0">
                <DataGrid x:Name="BarcodeGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="심볼" Binding="{Binding Source}" Width="90"/>
                        <DataGridTextColumn Header="필드" Binding="{Binding Field}" Width="80"/>
                        <DataGridTextColumn Header="값" Binding="{Binding Value}" Width="*"/>
                        <DataGridTextColumn Header="일치" Binding="{Binding State}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <!-- 우측: 뷰어/조작 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button Content="PDF 열기" Style="{StaticResource AccentButton}"
                        Click="OnOpenPdf"
                        ToolTip="검사할 라벨 PDF를 엽니다 (창에 끌어다 놓아도 됩니다)"/>
                <TextBlock x:Name="PdfNameLabel" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <CheckBox x:Name="AutoSaveCheck" Content="자동 저장"
                              VerticalAlignment="Center" Margin="0,0,10,0"
                              ToolTip="페이지 검사가 끝날 때마다 결과 이미지를 저장합니다"/>
                    <Button Content="결과 저장" Click="OnSaveCurrent"/>
                    <Button Content="저장 경로…" Margin="8,0,0,0" Click="OnPickSaveDir"/>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Background="#ECEFF3" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <ScrollViewer x:Name="ViewerScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="OnViewerWheel"
                              PreviewMouseDown="OnViewerMouseDown"
                              PreviewMouseMove="OnViewerMouseMove"
                              PreviewMouseUp="OnViewerMouseUp">
                    <Grid>
                        <TextBlock x:Name="ViewerPlaceholder"
                                   Text="PDF를 열거나 이 창에 끌어다 놓으세요"
                                   Foreground="{StaticResource MutedBrush}" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="40"/>
                        <Image x:Name="ViewerImage" Stretch="None"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <DockPanel Grid.Row="2" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="FirstButton" Content="⏮" Width="44" IsEnabled="False"
                            ToolTip="첫 페이지 (Home)" Click="OnFirstPage"/>
                    <Button x:Name="PrevButton" Content="◀" Width="44" Margin="4,0,0,0"
                            IsEnabled="False" ToolTip="이전 페이지 (←)" Click="OnPrevPage"/>
                    <Button x:Name="NextButton" Content="▶" Width="44" Margin="4,0,0,0"
                            IsEnabled="False" ToolTip="다음 페이지 (→)" Click="OnNextPage"/>
                    <Button x:Name="LastButton" Content="⏭" Width="44" Margin="4,0,0,0"
                            IsEnabled="False" ToolTip="끝 페이지 (End)" Click="OnLastPage"/>
                    <TextBlock x:Name="PageLabel" Text="- / -" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <TextBlock x:Name="PrefetchLabel" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,14,0"/>
                    <TextBlock Text="배율" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider x:Name="ZoomSlider" Width="160" Minimum="10" Maximum="500"
                            Value="100" VerticalAlignment="Center"
                            ValueChanged="OnZoomSliderChanged"/>
                    <TextBlock x:Name="ZoomLabel" Text="100%" Width="46"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
