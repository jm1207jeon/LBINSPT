<UserControl x:Class="LabelSuite.App.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
             Focusable="True" KeyDown="OnKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="430"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== 좌측 메인: 뷰어 ===================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="라벨 PDF">
                <WrapPanel>
                    <Button Content="PDF 열기" Style="{StaticResource AccentButton}"
                            Click="OnOpenPdf"
                            ToolTip="검사할 라벨 PDF를 엽니다 (창에 끌어다 놓아도 됩니다)"/>
                    <TextBlock x:Name="PdfNameLabel" VerticalAlignment="Center"
                               Margin="8,0" Foreground="{StaticResource AccentBrush}"
                               FontWeight="Bold"/>
                    <Separator Width="10" Visibility="Hidden"/>
                    <Button x:Name="FirstButton" Content="⏮" Width="36" IsEnabled="False"
                            ToolTip="첫 페이지 (Home)" Click="OnFirstPage"/>
                    <Button x:Name="PrevButton" Content="◀" Width="36" IsEnabled="False"
                            ToolTip="이전 페이지 (←)" Click="OnPrevPage"/>
                    <Button x:Name="NextButton" Content="▶" Width="36" IsEnabled="False"
                            ToolTip="다음 페이지 (→)" Click="OnNextPage"/>
                    <Button x:Name="LastButton" Content="⏭" Width="36" IsEnabled="False"
                            ToolTip="끝 페이지 (End)" Click="OnLastPage"/>
                    <TextBlock x:Name="PageLabel" Text="- / -" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="6,0"/>
                    <TextBlock x:Name="PrefetchLabel" VerticalAlignment="Center"
                               Margin="10,0" Foreground="Gray"/>
                    <Separator Width="10" Visibility="Hidden"/>
                    <TextBlock Text="배율:" VerticalAlignment="Center"/>
                    <Slider x:Name="ZoomSlider" Width="140" Minimum="10" Maximum="500"
                            Value="100" VerticalAlignment="Center" Margin="4,0"
                            ValueChanged="OnZoomSliderChanged"/>
                    <TextBlock x:Name="ZoomLabel" Text="100%" MinWidth="42"
                               VerticalAlignment="Center"/>
                    <Separator Width="10" Visibility="Hidden"/>
                    <CheckBox x:Name="AutoSaveCheck" Content="자동 저장"
                              ToolTip="페이지 검사가 끝날 때마다 결과 이미지를 저장합니다"/>
                    <Button Content="결과 저장" FontWeight="Bold" Click="OnSaveCurrent"/>
                    <Button Content="저장 경로" Click="OnPickSaveDir"/>
                </WrapPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="검사 화면 (녹색=합격 필드 / 주황=확인 필요)">
                <Grid Background="{StaticResource ImageBgBrush}">
                    <ScrollViewer x:Name="ViewerScroll" Background="Transparent"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="OnViewerWheel"
                                  PreviewMouseDown="OnViewerMouseDown"
                                  PreviewMouseMove="OnViewerMouseMove"
                                  PreviewMouseUp="OnViewerMouseUp">
                        <Image x:Name="ViewerImage" Stretch="None"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </ScrollViewer>
                    <TextBlock x:Name="ViewerPlaceholder"
                               Text="PDF를 열거나 이 창에 끌어다 놓으면 검사가 시작됩니다"
                               Foreground="{StaticResource ImageHintBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- ===================== 우측: 목록/판정/검증 ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="검사 목록 / 규격">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="목록 열기" Click="OnOpenList"/>
                        <TextBlock x:Name="ListStatus" VerticalAlignment="Center"
                                   Margin="6,0,0,0" TextWrapping="Wrap"
                                   Foreground="Gray"
                                   Text="목록 없음 — 목록 생성 탭에서 보내거나 파일을 여세요"/>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="LOT:" Width="34"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="LotMatchLabel" DockPanel.Dock="Right"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"/>
                        <ComboBox x:Name="LotCombo" SelectionChanged="OnLotChanged"/>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="규격:" Width="34"
                                   VerticalAlignment="Top" Margin="0,6,0,0"/>
                        <WrapPanel x:Name="StandardPanel"/>
                    </DockPanel>
                    <DockPanel Margin="0,2,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="검색:" Width="34"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox" KeyDown="OnSearchKeyDown"
                                 ToolTip="라벨에서 추가로 찾을 텍스트 (Enter로 적용)"/>
                    </DockPanel>
                </StackPanel>
            </GroupBox>

            <!-- 판정 배지: verifier의 대형 판독값 박스 스타일 -->
            <Border Grid.Row="1" x:Name="StatusBadge" Style="{StaticResource BadgeBorder}"
                    Margin="4,2,4,2">
                <TextBlock x:Name="StatusBadgeText" Text="검사 대기" FontSize="17"
                           FontWeight="Bold" Foreground="Gray" TextWrapping="Wrap"/>
            </Border>

            <GroupBox Grid.Row="2" Header="필드별 검출 (검출/기준)">
                <DataGrid x:Name="FieldGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="항목" Binding="{Binding Field}" Width="85"/>
                        <DataGridTextColumn Header="검사 값" Binding="{Binding Term}" Width="*"/>
                        <DataGridTextColumn Header="검출/기준" Binding="{Binding Count}" Width="70"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="pass">
                                    <Setter Property="Background"
                                            Value="{StaticResource SuccessBgBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="fail">
                                    <Setter Property="Background"
                                            Value="{StaticResource WarnBgBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Row="3" Header="바코드 검증 (데이터매트릭스 GS1 교차 확인)">
                <DataGrid x:Name="BarcodeGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="심볼로지" Binding="{Binding Source}" Width="85"/>
                        <DataGridTextColumn Header="항목" Binding="{Binding Field}" Width="70"/>
                        <DataGridTextColumn Header="값" Binding="{Binding Value}" Width="*"/>
                        <DataGridTextColumn Header="일치" Binding="{Binding State}" Width="55"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="일치">
                                    <Setter Property="Background"
                                            Value="{StaticResource SuccessBgBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="불일치">
                                    <Setter Property="Background"
                                            Value="{StaticResource WarnBgBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
