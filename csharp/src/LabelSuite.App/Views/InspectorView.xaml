<UserControl x:Class="LabelSuite.App.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
             Focusable="True" KeyDown="OnKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="430"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== 좌측 메인: 뷰어 ===================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="라벨 PDF">
                <StackPanel>
                <!-- 툴바 위계(UDInspect 규범): 주 동작=파랑(화면당 2개: PDF 열기·결과 저장), 주 액션은 우측 고정,
                     왼쪽은 기능군(열기 | 페이지 이동 | 배율 | 영역·로그 | 내보내기·경로)을 구분선으로 나눈다 -->
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <CheckBox x:Name="AutoSaveCheck" Content="자동 저장"
                                  Checked="OnAutoSaveToggled" Unchecked="OnAutoSaveToggled"
                                  ToolTip="페이지 검사가 끝날 때마다 결과 이미지를 저장합니다 (같은 판정은 한 번만 저장 · 설정은 즉시 저장되어 다음 실행에도 유지)"/>
                        <Button Content="결과 저장" Style="{StaticResource PrimaryButton}"
                                Click="OnSaveCurrent" Margin="12,0,0,0"
                                ToolTip="현재 페이지의 판정 결과 이미지를 저장하고 검사 이력에 기록합니다 (Ctrl+S)"/>
                    </StackPanel>
                    <WrapPanel>
                        <Button Content="PDF 열기" Style="{StaticResource PrimaryButton}"
                                Click="OnOpenPdf"
                                ToolTip="검사할 라벨 PDF를 엽니다 (Ctrl+O · 창에 끌어다 놓아도 됩니다)"/>
                        <TextBlock x:Name="PdfNameLabel" VerticalAlignment="Center"
                                   Margin="8,0" Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Bold"/>
                        <Separator Style="{StaticResource VSep}"/>
                        <Button x:Name="FirstButton" Content="⏮" Width="36" IsEnabled="False"
                                IsTabStop="False" AutomationProperties.Name="첫 페이지"
                                ToolTip="첫 페이지 (Home)" Click="OnFirstPage"/>
                        <Button x:Name="PrevButton" Content="◀" Width="36" IsEnabled="False"
                                IsTabStop="False" AutomationProperties.Name="이전 페이지"
                                ToolTip="이전 페이지 (←)" Click="OnPrevPage"/>
                        <Button x:Name="NextButton" Content="▶" Width="36" IsEnabled="False"
                                IsTabStop="False" AutomationProperties.Name="다음 페이지"
                                ToolTip="다음 페이지 (→)" Click="OnNextPage"/>
                        <Button x:Name="LastButton" Content="⏭" Width="36" IsEnabled="False"
                                IsTabStop="False" AutomationProperties.Name="끝 페이지"
                                ToolTip="끝 페이지 (End)" Click="OnLastPage"/>
                        <Button x:Name="NextAttentionButton" Content="다음 확인 대상 ▶" IsEnabled="False"
                                Click="OnNextAttention" AutomationProperties.Name="다음 확인 대상"
                                ToolTip="다음 미검사 또는 확인 필요 페이지로 이동 (N)"/>
                        <Separator Style="{StaticResource VSep}"/>
                        <Button x:Name="AutoInspectButton" Content="▶ 자동 검사" IsEnabled="False"
                                Style="{StaticResource AccentButton}" Click="OnAutoInspect"
                                AutomationProperties.Name="자동 검사"
                                ToolTip="전체 페이지를 순서대로 자동 검사해 합격 / 부적합(확인 필요) 로트를 나눕니다.&#10;OCR이 안 끝난 페이지는 기다립니다 · 실행 중 다시 누르면 중지 · 끝나면 결과 목록이 열립니다"/>
                        <Button x:Name="ResultListButton" Content="결과 목록" IsEnabled="False"
                                Click="OnShowResultList" AutomationProperties.Name="검사 결과 목록"
                                ToolTip="페이지·로트별 판정 목록 — 부적합만 보기, 행을 클릭해 해당 페이지로 이동,&#10;문제를 해결한 뒤 검사자 확인 합격 처리"/>
                        <TextBlock x:Name="PageLabel" Text="- / -" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="6,0"/>
                        <TextBlock x:Name="PrefetchLabel" VerticalAlignment="Center"
                                   Margin="10,0" Foreground="{StaticResource HintBrush}"
                                   ToolTip="백그라운드 OCR 진행 상태 (상태바 진행 막대와 동일)"/>
                        <TextBlock x:Name="AlignLabel" VerticalAlignment="Center"
                                   Margin="4,0" Style="{StaticResource CaptionText}"
                                   ToolTip="라벨 정렬: 하늘색 이형지 기준 크롭 · 라벨 잉크 기준 기울기 보정 상태"/>
                        <Separator Style="{StaticResource VSep}"/>
                        <TextBlock Text="배율:" VerticalAlignment="Center"/>
                        <Slider x:Name="ZoomSlider" Width="140" Minimum="10" Maximum="500"
                                Value="100" VerticalAlignment="Center" Margin="4,0"
                                ValueChanged="OnZoomSliderChanged"
                                ToolTip="확대/축소 (휠 · Q/E 키로도 조절)"/>
                        <TextBlock x:Name="ZoomLabel" Text="100%" MinWidth="42"
                                   VerticalAlignment="Center"/>
                        <Separator Style="{StaticResource VSep}"/>
                        <ToggleButton x:Name="ZoneModeButton" Content="✚ 필드 영역 등록"
                                      Checked="OnZoneModeChanged" Unchecked="OnZoneModeChanged"
                                      ToolTip="켠 상태에서 라벨 위를 드래그(영역) 또는 클릭(객체)하면 그 위치를 필드 검출 영역으로 등록합니다.&#10;다시 누르거나 Esc를 누르면 해제됩니다"/>
                        <CheckBox x:Name="ShowZonesCheck" Content="영역 표시"
                                  Checked="OnShowZonesToggled" Unchecked="OnShowZonesToggled"
                                  ToolTip="등록된 필드 영역·양식 규칙 영역을 점선으로 표시합니다 (설정은 즉시 저장)"/>
                        <Button Content="OCR 로그" Click="OnShowOcrLog"
                                ToolTip="이 페이지에서 OCR이 실제로 읽은 모든 단어를 위→아래 순으로 보여줍니다 (Ctrl+Shift+L · 미검출 원인 확인·교정·병합 등록)"/>
                        <Separator Style="{StaticResource VSep}"/>
                        <Button Content="CSV 내보내기" Click="OnExportCsv"
                                ToolTip="전체 페이지의 판정 결과를 CSV로 내보냅니다 (미검사 페이지도 행으로 포함 · 엑셀에서 지수 표기·선행 0 소실 없음)"/>
                        <Button Content="저장 경로" Click="OnPickSaveDir"
                                ToolTip="결과 이미지 저장 폴더를 지정합니다 (재실행 시에도 유지)"/>
                        <Button Content="폴더 열기" Click="OnOpenSaveDir"
                                ToolTip="결과 이미지 저장 폴더를 탐색기로 엽니다"/>
                    </WrapPanel>
                </DockPanel>
                <!-- 페이지 상태 슬롯: 회색=OCR 대기 / 흰=검사 대기 / 녹 ✓=합격 / 주황 !=확인 필요 / ?=LOT 미매칭 /
                     녹 ✓ 굵은 초록 테두리=검사자 확인 합격, 하단 초록 띠=저장됨, 파랑 굵은 테두리=현재. 클릭=이동 -->
                <ItemsControl x:Name="PageSlots" Margin="2,4,2,0"
                              ToolTip="페이지 슬롯 — 회색=OCR 대기 / 흰=검사 대기 / 녹 ✓=합격 / 주황 !=확인 필요 / ?=LOT 미매칭 / 굵은 초록 테두리=검사자 확인 합격 / 초록 띠=저장됨 / 파랑 굵은 테두리=현재 (클릭: 이동)">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Fill}" BorderBrush="{Binding Stroke}"
                                    BorderThickness="{Binding StrokeThickness}" Height="24"
                                    Margin="1,0" Cursor="Hand"
                                    MouseLeftButtonDown="OnPageSlotClick"
                                    Tag="{Binding PageIndex}" ToolTip="{Binding Tip}">
                                <Grid>
                                    <TextBlock Text="{Binding Number}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="{StaticResource CaptionSize}"
                                               FontWeight="{Binding Weight}" Margin="0,0,0,3"
                                               Foreground="{Binding TextBrush}"/>
                                    <Rectangle Height="3" VerticalAlignment="Bottom"
                                               Fill="{StaticResource SavedGreenBrush}"
                                               Visibility="{Binding Saved, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="검사 화면">
                <DockPanel LastChildFill="True">
                    <!-- 색 견본 범례: 저장 이미지·화면 오버레이와 같은 색 (Core Annotate 상수와 동기화) -->
                    <WrapPanel DockPanel.Dock="Top" x:Name="LegendPanel"
                               Background="{StaticResource SoftPanelBrush}" Margin="0,0,0,2">
                        <Border Style="{StaticResource Chip}" Margin="4,2,6,2"
                                ToolTip="기대값과 일치해 검출된 필드 박스 (색은 설정 › 필드 색)">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle x:Name="LegendFieldSwatch" Width="12" Height="12" Margin="0,0,4,0"
                                           Fill="{StaticResource SuccessBgBrush}" Stroke="{StaticResource SuccessBrush}"/>
                                <TextBlock Text="합격 필드" FontSize="{StaticResource CaptionSize}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Chip}" Margin="0,2,6,2"
                                ToolTip="확인 필요 — 필드 누락·불일치·LOT 미매칭 (검사자 확인 대기, 불합격 아님)">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="12" Height="12" Margin="0,0,4,0"
                                           Fill="{StaticResource WarnBgBrush}" Stroke="{StaticResource WarnBrush}"/>
                                <TextBlock Text="확인 필요" FontSize="{StaticResource CaptionSize}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Chip}" Margin="0,2,6,2"
                                ToolTip="검출된 바코드 박스 — DataMatrix는 위치 표시만(카운트·검증 제외), GS1-128은 아래 표에서 GTIN 대조">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="12" Height="12" Margin="0,0,4,0"
                                           Fill="{StaticResource OverlayBarcodeBrush}"/>
                                <TextBlock Text="바코드" FontSize="{StaticResource CaptionSize}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Chip}" Margin="0,2,6,2"
                                ToolTip="규격 자동 선택에 쓰인 라벨 문서번호(Rev.A00 · BSL-01 …) 영역 · 양식 규칙 영역(점선)">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="12" Height="12" Margin="0,0,4,0"
                                           Fill="{StaticResource OverlayFormBrush}"/>
                                <TextBlock Text="문서번호" FontSize="{StaticResource CaptionSize}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Chip}" Margin="0,2,6,2"
                                ToolTip="검출된 필드 중 OCR 신뢰도가 낮은 단어 (주황 파선) — 오인식 가능성, 육안 확인. 필드가 아닌 단어에는 표시하지 않음">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="12" Height="12" Margin="0,0,4,0" Fill="Transparent"
                                           Stroke="{StaticResource OverlayLowConfBrush}" StrokeThickness="2"
                                           StrokeDashArray="2 2"/>
                                <TextBlock Text="저신뢰 단어" FontSize="{StaticResource CaptionSize}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Chip}" Margin="0,2,6,2"
                                ToolTip="바코드 값이 목록과 불일치 · GS1 해석 불가 (표에서 붉은 행)">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="12" Height="12" Margin="0,0,4,0"
                                           Fill="{StaticResource FailBgBrush}" Stroke="{StaticResource FailFgBrush}"/>
                                <TextBlock Text="불일치" FontSize="{StaticResource CaptionSize}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Chip}" Margin="0,2,6,2"
                                ToolTip="등록된 필드 영역 (파란 점선 + 필드명 칩) — 영역 안 검출만 인정">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="12" Height="12" Margin="0,0,4,0" Fill="Transparent"
                                           Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.5"
                                           StrokeDashArray="3 1.5"/>
                                <TextBlock Text="등록 영역" FontSize="{StaticResource CaptionSize}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ShortcutChip" Style="{StaticResource Chip}" Margin="0,2,4,2"
                                ToolTip="←→ 페이지 · Home/End 처음/끝 · N 다음 확인 대상 · Ctrl+O 열기 · Ctrl+S 저장 · F5 재검사&#10;Ctrl+L LOT · Ctrl+F 검색 · Ctrl+Shift+L OCR 로그 · Esc 등록 모드 해제&#10;W A S D 이동 · Q/E 확대·축소 · 휠 줌">
                            <TextBlock Text="⌨ 단축키" FontSize="{StaticResource CaptionSize}" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        </Border>
                    </WrapPanel>
                    <!-- 영역 등록 모드 배너: 상태바(시선 밖) 대신 본문 위에 모드 상태를 표시 -->
                    <Border DockPanel.Dock="Top" x:Name="ZoneModeBanner" Style="{StaticResource AlertBanner}"
                            Visibility="Collapsed">
                        <TextBlock Text="✚ 필드 영역 등록 모드 — 라벨 위를 드래그(영역) 또는 클릭(객체) · Esc 또는 버튼으로 해제"
                                   FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                    </Border>
                    <Grid Background="{StaticResource ImageBgBrush}">
                        <ScrollViewer x:Name="ViewerScroll" Background="Transparent"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="OnViewerWheel"
                                      PreviewMouseDown="OnViewerMouseDown"
                                      PreviewMouseMove="OnViewerMouseMove"
                                      PreviewMouseUp="OnViewerMouseUp">
                            <Grid>
                                <Image x:Name="ViewerImage" Stretch="None"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Canvas x:Name="ViewerOverlayCanvas" IsHitTestVisible="False">
                                    <!-- 등록된 필드 영역·양식 규칙 영역 (점선+칩) — DrawZones()가 채운다 -->
                                    <Canvas x:Name="ZoneLayer" IsHitTestVisible="False"/>
                                    <Rectangle x:Name="RubberBand" Stroke="{StaticResource RubberStrokeBrush}"
                                               StrokeThickness="2" StrokeDashArray="4 2"
                                               Fill="{StaticResource RubberFillBrush}" Visibility="Collapsed"/>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                        <StackPanel x:Name="ViewerPlaceholder" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" IsHitTestVisible="False">
                            <Image Source="{StaticResource LavisLogo}" Width="96" Height="96" Opacity="0.55"
                                   Margin="0,0,0,10"/>
                            <TextBlock Text="PDF를 열거나 이 창에 끌어다 놓으면 검사가 시작됩니다"
                                       Foreground="{StaticResource ImageHintBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Ctrl+O 열기 · 열린 뒤 ←→ 페이지 이동" Margin="0,4,0,0"
                                       Foreground="{StaticResource ImageHintBrush}" HorizontalAlignment="Center"
                                       FontSize="{StaticResource CaptionSize}"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </GroupBox>
        </Grid>

        <!-- ===================== 우측: 집계/목록/판정/검증 ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>

            <!-- 집계 줄: UDInspect 멀티 스캔 상단의 큰 숫자 (합격=녹색 / 확인 필요=주황) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,2,6,0">
                <TextBlock x:Name="PassCountText" Text="0" Style="{StaticResource BigCount}"
                           Foreground="{StaticResource SuccessBrush}"
                           ToolTip="합격 판정 페이지 수"/>
                <TextBlock Text="합격" Style="{StaticResource BigCountLabel}"
                           Foreground="{StaticResource SuccessBrush}"/>
                <TextBlock x:Name="CheckCountText" Text="0" Style="{StaticResource BigCount}"
                           Foreground="{StaticResource CountOrangeBrush}"
                           ToolTip="확인 필요(필드 누락·불일치·저신뢰) 페이지 수 — 검사자가 화면에서 확인 후 판정합니다"/>
                <TextBlock Text="확인 필요" Style="{StaticResource BigCountLabel}"
                           Foreground="{StaticResource CountOrangeBrush}"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressCountText" Text="검사 0 / 0 · 미검사 0"
                               FontSize="{StaticResource SubCountSize}" FontWeight="Bold" Foreground="{StaticResource HintBrush}"
                               ToolTip="판정이 끝난 페이지 / 전체 페이지 · 미검사 = OCR 대기·LOT 미매칭·아직 열지 않은 페이지 수 (N 키로 이동)"/>
                    <!-- 미저장 상시 표시: 종료·PDF 교체 전에 저장을 유도 -->
                    <TextBlock x:Name="DirtyText" Text="" FontWeight="Bold" Margin="0,2,0,0"
                               ToolTip="판정된 페이지 중 결과 이미지가 저장되지 않은 수입니다 — [결과 저장] 또는 [자동 저장]으로 저장됩니다"/>
                </StackPanel>
            </StackPanel>

            <GroupBox Grid.Row="1" Header="검사 목록 / 규격 (규격 버튼 클릭 = 이 페이지만 수동 지정)">
                <StackPanel KeyboardNavigation.TabNavigation="Local">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="목록 열기" Click="OnOpenList" TabIndex="1"
                                AutomationProperties.Name="검사 목록 열기"
                                ToolTip="검사 목록(xlsx/csv)을 엽니다 — 목록 생성 탭에서 보낼 수도 있습니다"/>
                        <TextBlock x:Name="ListStatus" VerticalAlignment="Center"
                                   Margin="6,0,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource HintBrush}"
                                   Text="목록 없음 — 목록 생성 탭에서 보내거나 파일을 여세요"/>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="LOT:" Width="34"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="LotMatchLabel" DockPanel.Dock="Right"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"/>
                        <ComboBox x:Name="LotCombo" SelectionChanged="OnLotChanged" TabIndex="2"
                                  AutomationProperties.Name="LOT 선택"
                                  ToolTip="검사 목록의 LOT — 라벨에서 읽힌 LOT과 자동으로 맞춰집니다 (Ctrl+L)"/>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="규격:" Width="34"
                                   VerticalAlignment="Top" Margin="0,6,0,0"/>
                        <WrapPanel x:Name="StandardPanel" KeyboardNavigation.TabIndex="3"
                                   KeyboardNavigation.TabNavigation="Local"
                                   AutomationProperties.Name="규격 선택"/>
                    </DockPanel>
                    <!-- 라벨에 인쇄된 문서번호(Rev.A00 · BSL-01 · PML-001(Rev.1))로 규격을 자동 선택 — 목록의 규격 열은 쓰지 않는다 -->
                    <DockPanel x:Name="FormRow" Margin="0,4,0,0"
                               ToolTip="라벨에서 읽은 양식 문서번호 → 자동 선택된 규격. 미감지면 이전 규격을 유지하고, 규격 버튼으로 이 페이지만 수동 지정할 수 있습니다">
                        <TextBlock DockPanel.Dock="Left" Text="문서:" Width="34"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" x:Name="LearnFormButton" Content="양식 학습"
                                Click="OnLearnForm" Visibility="Collapsed"
                                ToolTip="현재 페이지의 규칙 영역 이미지를 이 양식의 기준 템플릿으로 학습합니다 (설정 › 라벨 양식 감지에 '이미지' 규칙이 있을 때)"/>
                        <TextBlock x:Name="FormMatchLabel" VerticalAlignment="Center"
                                   FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource SuccessBrush}"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </DockPanel>
                    <DockPanel Margin="0,2,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="검색:" Width="34"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox" KeyDown="OnSearchKeyDown" TabIndex="4"
                                 AutomationProperties.Name="추가 검색어"
                                 ToolTip="라벨에서 추가로 찾을 텍스트 (Enter로 적용 · Ctrl+F) — 미등록 문구도 검색해 바운딩 박스로 표시"/>
                    </DockPanel>
                </StackPanel>
            </GroupBox>

            <!-- 판정 배지: UDInspect의 대형 판독값 박스 스타일 (24px + 상태색 테두리 2px + 사유줄) -->
            <Border Grid.Row="2" x:Name="StatusBadge" Style="{StaticResource BadgeBorder}"
                    BorderThickness="2" Margin="4,2,4,2"
                    ToolTip="프로그램의 검출 결과 요약입니다 — 최종 판정은 검사자가 합니다. '확인 필요'는 불합격이 아니라 검사자 확인 대기입니다">
                <StackPanel>
                    <!-- 판정 헤드라인은 한 줄 — 넘치면 말줄임(…) + 툴팁에 전문. 판정 없음(OCR 실패·목록 없음) 메시지는
                         코드에서 SubCountSize로 줄여 표시한다 (24px로 잘려 보이던 문제) -->
                    <TextBlock x:Name="StatusBadgeText" Text="검사 대기" Style="{StaticResource ReadoutText}"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <TextBlock x:Name="BadgeReasonText" Text="" Style="{StaticResource CaptionText}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
            </Border>

            <GroupBox Grid.Row="3" Header="필드별 검출 (GTIN: 바코드 판독 → OCR 순 · 더블클릭: 미검출 진단·교정 등록)">
                <DataGrid x:Name="FieldGrid" MouseDoubleClick="OnFieldDoubleClick" TabIndex="5"
                          AutomationProperties.Name="필드별 검출 결과">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="" Binding="{Binding Glyph}" Width="26"
                                            ElementStyle="{StaticResource CenterCell}"/>
                        <DataGridTextColumn Header="항목" Binding="{Binding Field}" Width="85"/>
                        <DataGridTextColumn Header="검사 값" Binding="{Binding Term}" Width="*"/>
                        <DataGridTextColumn Header="검출/기준" Binding="{Binding Count}" Width="70"
                                            ElementStyle="{StaticResource CenterCell}"/>
                        <!-- 출처: GTIN은 바코드 판독 → OCR 순 (어느 경로로 읽었는지 표시) -->
                        <DataGridTextColumn Header="출처" Binding="{Binding Source}" Width="52"
                                            ElementStyle="{StaticResource CenterCell}"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="pass">
                                    <Setter Property="Background"
                                            Value="{StaticResource SuccessBgBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="fail">
                                    <Setter Property="Background"
                                            Value="{StaticResource WarnBgBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <!-- 추출 실패(바코드·OCR 모두 없음)는 확인 필요가 아니라 오류 — 붉은 행 -->
                                <DataTrigger Binding="{Binding State}" Value="error">
                                    <Setter Property="Background"
                                            Value="{StaticResource FailBgBrush}"/>
                                    <Setter Property="Foreground"
                                            Value="{StaticResource FailFgBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Row="4" Header="바코드 검증 (GS1-128 등 · DataMatrix는 박스 표시만 · 위→아래 순)">
                <DataGrid x:Name="BarcodeGrid" AutomationProperties.Name="바코드 검증 결과">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No." Binding="{Binding Order}" Width="38"
                                            ElementStyle="{StaticResource RightCell}"/>
                        <DataGridTextColumn Header="종류" Binding="{Binding Symbology}" Width="105"/>
                        <DataGridTextColumn Header="등급" Binding="{Binding Grade}" Width="56"
                                            ElementStyle="{StaticResource CenterCell}"/>
                        <DataGridTextColumn Header="값" Binding="{Binding Value}" Width="*"/>
                        <DataGridTextColumn Header="일치" Binding="{Binding State}" Width="64"
                                            ElementStyle="{StaticResource CenterCell}"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding Tip}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="일치">
                                    <Setter Property="Background"
                                            Value="{StaticResource SuccessBgBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="불일치">
                                    <Setter Property="Background"
                                            Value="{StaticResource FailBgBrush}"/>
                                    <Setter Property="Foreground"
                                            Value="{StaticResource FailFgBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="해석 불가">
                                    <Setter Property="Background"
                                            Value="{StaticResource FailBgBrush}"/>
                                    <Setter Property="Foreground"
                                            Value="{StaticResource FailFgBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
