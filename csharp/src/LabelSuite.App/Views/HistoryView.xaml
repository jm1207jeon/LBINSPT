<UserControl x:Class="LabelSuite.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="LOT" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="LotFilter" Width="160" KeyDown="OnFilterKeyDown"
                     ToolTip="LOT 검색 (Enter)"/>
            <TextBlock Text="판정" VerticalAlignment="Center" Margin="14,0,6,0"/>
            <ComboBox x:Name="VerdictFilter" Width="110" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="전체" IsSelected="True"/>
                <ComboBoxItem Content="합격"/>
                <ComboBoxItem Content="확인 필요"/>
            </ComboBox>
            <Button Content="새로고침" Margin="10,0,0,0" Click="OnRefresh"/>
            <Button Content="LOT 리포트 내보내기" DockPanel.Dock="Right"
                    HorizontalAlignment="Right" Click="OnExportReport"/>
        </DockPanel>

        <DataGrid Grid.Row="1" x:Name="Table" MouseDoubleClick="OnRowDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="일시" Binding="{Binding Ts}" Width="150"/>
                <DataGridTextColumn Header="LOT" Binding="{Binding Lot}"/>
                <DataGridTextColumn Header="REF" Binding="{Binding Ref}" Width="*"/>
                <DataGridTextColumn Header="PN" Binding="{Binding Pn}"/>
                <DataGridTextColumn Header="규격" Binding="{Binding Standard}"/>
                <DataGridTextColumn Header="페이지" Binding="{Binding Page}"/>
                <DataGridTextColumn Header="판정" Binding="{Binding Verdict}"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Verdict}" Value="합격">
                            <Setter Property="Background"
                                    Value="{StaticResource SuccessBgBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Verdict}" Value="확인 필요">
                            <Setter Property="Background"
                                    Value="{StaticResource WarnBgBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="행을 더블클릭하면 저장된 결과 이미지를 엽니다."
                   Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
    </Grid>
</UserControl>
