<UserControl x:Class="LabelSuite.App.Views.GeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 좌측: 파일 + 날짜 + 실행 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="입력 파일">
                <StackPanel>
                    <TextBlock Text="엑셀 파일을 이 창에 끌어다 놓으면 자동으로 분류됩니다"
                               Foreground="{StaticResource MutedBrush}" FontWeight="Normal"
                               Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="주문일정 체크리스트" Click="OnPickSchedule" ToolTip="주문일정 체크리스트 엑셀 파일 선택"/>
                        <TextBlock x:Name="ScheduleStatus" Grid.Column="1" Text="선택되지 않음"
                                   Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="제품 품목번호 리스트" Click="OnPickProduct" ToolTip="PN → GTIN/REF 조회용 품목번호 리스트 선택"/>
                        <TextBlock x:Name="ProductStatus" Grid.Column="1" Text="선택되지 않음"
                                   Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="BSC FGD 리스트" Click="OnPickBsc" ToolTip="BSC 규격 REF 조회용 FGD 리스트 선택"/>
                        <TextBlock x:Name="BscStatus" Grid.Column="1" Text="선택되지 않음"
                                   Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="제조일 선택" Margin="0,10,0,0">
                <TreeView x:Name="DateTree" BorderThickness="0"
                          Background="{StaticResource PanelBrush}"/>
            </GroupBox>

            <!-- 버튼 위계: 파랑(주 동작)은 화면당 하나 — 리스트 생성. 보내기는 네이비 강조, 저장은 기본 크롬 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="GenerateButton" Content="리스트 생성" IsEnabled="False"
                        Style="{StaticResource PrimaryButton}" Click="OnGenerate"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="주문일정 체크리스트를 열고 제조일을 선택하면 활성화됩니다"/>
                <Button x:Name="SaveButton" Content="엑셀로 저장" IsEnabled="False"
                        Margin="8,0,0,0" Click="OnSaveXlsx"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="생성된 목록을 xlsx로 저장합니다 — 검사 탭 [목록 열기]로 다시 불러올 수 있음"/>
                <Button x:Name="SendButton" Content="검사 탭으로 보내기 →" IsEnabled="False"
                        Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                        Click="OnSendToInspector"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="생성된 목록을 라벨 검사 탭에 올리고 그 탭으로 이동합니다 (목록을 먼저 생성하세요)"/>
            </StackPanel>
        </Grid>

        <!-- 우측: 미리보기 + 이슈 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" x:Name="PreviewGroup" Header="미리보기">
                <DataGrid x:Name="PreviewGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="LOT" Binding="{Binding Lot}"/>
                        <DataGridTextColumn Header="PRODUCTS" Binding="{Binding Products}" Width="*"/>
                        <DataGridTextColumn Header="PN" Binding="{Binding Pn}"/>
                        <DataGridTextColumn Header="REF" Binding="{Binding Ref}"/>
                        <DataGridTextColumn Header="MFG DATE" Binding="{Binding MfgDate}"/>
                        <DataGridTextColumn Header="EXP DATE" Binding="{Binding ExpDate}"/>
                        <DataGridTextColumn Header="GTIN" Binding="{Binding Gtin}"/>
                    </DataGrid.Columns>
                    <!-- 같은 제조일·PN 묶음이 바뀔 때마다 배경을 교대로 — 묶음 경계를 눈으로 구분 -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GroupAlt}" Value="True">
                                    <Setter Property="Background"
                                            Value="{StaticResource GroupAltBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </GroupBox>
            <GroupBox Grid.Row="2" Header="경고/오류">
                <TextBox x:Name="IssuesBox" IsReadOnly="True" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
