<UserControl x:Class="LabelSuite.App.Views.GeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 좌측: 파일 + 날짜 + 실행 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="입력 파일">
                <StackPanel>
                    <TextBlock Text="엑셀 파일을 이 창에 끌어다 놓으면 자동으로 분류됩니다"
                               Foreground="{StaticResource MutedBrush}" FontWeight="Normal"
                               Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="주문일정 체크리스트" Click="OnPickSchedule"/>
                        <TextBlock x:Name="ScheduleStatus" Grid.Column="1" Text="선택되지 않음"
                                   Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="제품 품목번호 리스트" Click="OnPickProduct"/>
                        <TextBlock x:Name="ProductStatus" Grid.Column="1" Text="선택되지 않음"
                                   Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="BSC FGD 리스트" Click="OnPickBsc"/>
                        <TextBlock x:Name="BscStatus" Grid.Column="1" Text="선택되지 않음"
                                   Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="제조일 선택" Margin="0,10,0,0">
                <TreeView x:Name="DateTree" BorderThickness="0"
                          Background="{StaticResource PanelBrush}"/>
            </GroupBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="GenerateButton" Content="리스트 생성" IsEnabled="False"
                        Style="{StaticResource AccentButton}" Click="OnGenerate"/>
                <Button x:Name="SaveButton" Content="엑셀로 저장" IsEnabled="False"
                        Margin="8,0,0,0" Click="OnSaveXlsx"/>
                <Button x:Name="SendButton" Content="검사 탭으로 보내기 →" IsEnabled="False"
                        Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                        Click="OnSendToInspector"/>
            </StackPanel>
        </Grid>

        <!-- 우측: 미리보기 + 이슈 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Header="미리보기">
                <DataGrid x:Name="PreviewGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="LOT" Binding="{Binding Lot}"/>
                        <DataGridTextColumn Header="PRODUCTS" Binding="{Binding Products}" Width="*"/>
                        <DataGridTextColumn Header="PN" Binding="{Binding Pn}"/>
                        <DataGridTextColumn Header="REF" Binding="{Binding Ref}"/>
                        <DataGridTextColumn Header="MFG DATE" Binding="{Binding MfgDate}"/>
                        <DataGridTextColumn Header="EXP DATE" Binding="{Binding ExpDate}"/>
                        <DataGridTextColumn Header="GTIN" Binding="{Binding Gtin}"/>
                        <DataGridTextColumn Header="STANDARD" Binding="{Binding Standard}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <GroupBox Grid.Row="2" Header="경고/오류">
                <TextBox x:Name="IssuesBox" IsReadOnly="True" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
