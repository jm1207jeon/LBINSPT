<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Zebra 2D-Verifier(ZebraScannerSuite)와 동일한 네이티브 계기판 스타일.
         커스텀 컨트롤 템플릿 없이 기본 WPF 룩 + 최소한의 여백/강조색만 정의한다. -->

    <!-- 팔레트 (verifier MainWindow.xaml에서 추출) -->
    <SolidColorBrush x:Key="BgBrush" Color="#F0F0F0"/>          <!-- 기본 창 배경 -->
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D5D5D5"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="MutedBrush" Color="Gray"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#1A5276"/>      <!-- 네이비 강조 -->
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#154360"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF2F8"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E8449"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#D5F5E3"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#CA6F1E"/>
    <SolidColorBrush x:Key="WarnBgBrush" Color="#FDEBD0"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B03A2E"/>      <!-- verifier 경고색 -->
    <SolidColorBrush x:Key="ReadoutBrush" Color="#FDF6E3"/>     <!-- 크림색 판독값 배경 -->
    <SolidColorBrush x:Key="ImageBgBrush" Color="#1E1E1E"/>     <!-- 어두운 이미지 영역 -->
    <SolidColorBrush x:Key="ImageHintBrush" Color="#9E9E9E"/>

    <!-- 기본 위젯: verifier App.xaml과 동일한 최소 스타일 -->
    <Style TargetType="Button">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="2"/>
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="6"/>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="2"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="2,3"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4,2"/>
    </Style>

    <!-- 강조 버튼: verifier 방식 — 굵은 글씨 + 네이비 텍스트 (기본 크롬 유지) -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <!-- 데이터그리드: 기본 룩 + 동작 옵션만 -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E5E5E5"/>
        <Setter Property="AlternatingRowBackground" Value="#F7F7F7"/>
    </Style>

    <!-- 상태 배지: 크림색 판독값 박스 스타일 (verifier의 BarcodeText 박스) -->
    <Style x:Key="BadgeBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ReadoutBrush}"/>
        <Setter Property="BorderBrush" Value="#D8D0B8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>

    <!-- 규격 선택 토글: 체크 시 네이비 배경 (기본 크롬 최소 변형) -->
    <Style x:Key="StandardToggle" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,4,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border" Background="#FDFDFD"
                            BorderBrush="#ADADAD" BorderThickness="1" Padding="9,4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background"
                                    Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush"
                                    Value="{StaticResource AccentHoverBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background"
                                    Value="{StaticResource AccentSoftBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
