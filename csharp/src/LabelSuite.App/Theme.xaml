<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- ============================================================
         LaVIS 패밀리 디자인 토큰 — 자매 제품 UDInspect(2D-Verifier)와 동일한 규범.
         원칙: 커스텀 컨트롤 템플릿 없이 기본 WPF 크롬 + 색·굵기·여백만으로 위계를 만든다.
           · 강조(주 동작) 버튼 = 파랑 배경 흰 굵은 글씨 (#1A6FB5)
           · 파괴적 동작 버튼   = 빨강 배경 흰 굵은 글씨 (#D9534F), 우측 끝에 분리 배치 + 확인 대화상자(기본 '아니오')
           · 주의 동작 버튼     = 주황 배경 검정 굵은 글씨 (#F0AD4E)
           · 안내문             = 12px #666666 / 큰 숫자 집계 = 56px 굵게
           · 상태바             = 정보(검정) / 경고(갈색 굵게 #9A5B00) / 오류(빨강 굵게 #B01E1E)
           · 표(DataGrid)       = 전체 격자선 #DDDDDD, 행 높이 24, 글꼴 13, 행 헤더 없음
         ============================================================ -->

    <!-- 팔레트: 기본 -->
    <SolidColorBrush x:Key="BgBrush" Color="#F0F0F0"/>          <!-- 기본 창 배경 -->
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D5D5D5"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#666666"/>
    <SolidColorBrush x:Key="HintBrush" Color="#666666"/>        <!-- 안내문 -->
    <SolidColorBrush x:Key="GridLineBrush" Color="#DDDDDD"/>    <!-- 표 격자선 -->

    <!-- 팔레트: 브랜드 (UDInspect 아이콘·버튼과 동일) -->
    <SolidColorBrush x:Key="InkBrush" Color="#222B36"/>         <!-- 아이콘 격자/잉크 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#1A6FB5"/>     <!-- 주 동작 파랑 -->
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#E3F0FB"/> <!-- 파란 칩 배경 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#1A5276"/>      <!-- 네이비 강조 글씨 -->
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF2F8"/>
    <SolidColorBrush x:Key="SoftPanelBrush" Color="#F3F6FA"/>   <!-- 연파랑 패널 -->
    <SolidColorBrush x:Key="SoftPanelBorderBrush" Color="#B9C4D0"/>
    <SolidColorBrush x:Key="GroupAltBrush" Color="#E8F1FA"/>    <!-- 묶음 교대 배경 -->

    <!-- 팔레트: 의미색 -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E8449"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#D5F5E3"/>
    <SolidColorBrush x:Key="ScannedBgBrush" Color="#D7EFD7"/>   <!-- 확인됨 칸 채움 -->
    <SolidColorBrush x:Key="CheckBrush" Color="#2E9E4F"/>       <!-- 아이콘 체크 녹색 -->
    <SolidColorBrush x:Key="WarnBrush" Color="#CA6F1E"/>
    <SolidColorBrush x:Key="WarnBgBrush" Color="#FDEBD0"/>
    <SolidColorBrush x:Key="CountOrangeBrush" Color="#E67E00"/> <!-- 큰 숫자 집계(주황) -->
    <SolidColorBrush x:Key="DangerBrush" Color="#B03A2E"/>      <!-- 경고 글씨 -->
    <SolidColorBrush x:Key="DangerButtonBrush" Color="#D9534F"/><!-- 파괴적 버튼 -->
    <SolidColorBrush x:Key="CautionButtonBrush" Color="#F0AD4E"/><!-- 주의 버튼 -->
    <SolidColorBrush x:Key="FailBgBrush" Color="#FFC7CE"/>      <!-- 부적합/만료 행 -->
    <SolidColorBrush x:Key="FailFgBrush" Color="#9C0006"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="#FFF3CD"/>   <!-- 최근 행 앰버 강조 -->
    <SolidColorBrush x:Key="StatusWarnBrush" Color="#9A5B00"/>  <!-- 상태바 경고 -->
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#B01E1E"/> <!-- 상태바 오류 -->
    <SolidColorBrush x:Key="SavedGreenBrush" Color="#2E7D32"/>  <!-- ✓ 저장됨 -->
    <SolidColorBrush x:Key="InvalidInputBrush" Color="#FFE4E1"/><!-- 잘못된 입력란 배경 -->
    <Color x:Key="FlashAmberColor">#FFFFC107</Color>            <!-- 행 강조 페이드(650ms) -->
    <Color x:Key="FlashOrangeColor">#FFFF9800</Color>           <!-- 셀 강조 페이드(900ms) -->
    <SolidColorBrush x:Key="ReadoutBrush" Color="#FDF6E3"/>     <!-- 크림색 판독값 배경 -->
    <SolidColorBrush x:Key="ReadoutBorderBrush" Color="#BBB69A"/>
    <SolidColorBrush x:Key="ImageBgBrush" Color="#1E1E1E"/>     <!-- 어두운 이미지 영역 -->
    <SolidColorBrush x:Key="ImageHintBrush" Color="#9E9E9E"/>
    <SolidColorBrush x:Key="OverlayDimBrush" Color="#66000000"/><!-- 창 안 오버레이 딤 -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#C8CCD2"/>  <!-- 선택 카드 보통 테두리 -->
    <!-- 페이지 슬롯 5상태 -->
    <SolidColorBrush x:Key="SlotIdleBrush" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="SlotBorderBrush" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="SlotIdleTextBrush" Color="#9A9A9A"/>
    <!-- 영역 등록 러버밴드 (UDInspect 강제 스캔 박스와 동일한 주황 반투명) -->
    <SolidColorBrush x:Key="RubberStrokeBrush" Color="#96FF9800"/>
    <SolidColorBrush x:Key="RubberFillBrush" Color="#18FF9800"/>
    <!-- 오버레이 색 — Core Annotate 상수(BarcodeBoxColor/FormBoxColor/LowConfidenceColor)와 동기화 (ThemeTokenTests가 검증) -->
    <SolidColorBrush x:Key="OverlayBarcodeBrush" Color="#008080"/>
    <SolidColorBrush x:Key="OverlayFormBrush" Color="#8000A0"/>
    <SolidColorBrush x:Key="OverlayLowConfBrush" Color="#FF8C00"/>
    <!-- 크기 토큰 -->
    <sys:Double x:Key="BigCountSize">56</sys:Double>
    <sys:Double x:Key="ReadoutSize">24</sys:Double>
    <sys:Double x:Key="SubCountSize">15</sys:Double>
    <sys:Double x:Key="CaptionSize">11</sys:Double>

    <!-- 기본 위젯: UDInspect App.xaml과 동일한 최소 스타일 -->
    <Style TargetType="Button">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="2"/>
    </Style>
    <Style TargetType="ToggleButton">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="2"/>
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="6"/>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="2"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="2,3"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4,2"/>
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4,2"/>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <!-- 버튼 위계 -->
    <!-- 강조(네이비 글씨): 보조 강조 — 기본 크롬 유지 -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>
    <!-- 주 동작(파랑 배경 흰 글씨): 화면당 1~2개 — PDF 열기 / 저장 / PDF 출력 -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="14,5"/>
    </Style>
    <!-- 파괴적 동작(빨강): 삭제·초기화 — 우측 끝 분리 배치 + 확인 대화상자 -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DangerButtonBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="12,5"/>
    </Style>
    <!-- 주의 동작(주황): 선택 행 삭제 등 되돌리기 어려운 부분 동작 -->
    <Style x:Key="CautionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource CautionButtonBrush}"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="12,5"/>
    </Style>

    <!-- 툴바 기능군 구분선 -->
    <Style x:Key="VSep" TargetType="Separator">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Margin" Value="6,0"/>
        <Setter Property="Background" Value="{StaticResource GridLineBrush}"/>
    </Style>

    <!-- 텍스트 위계 -->
    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource HintBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaptionSize}"/>
        <Setter Property="Foreground" Value="{StaticResource HintBrush}"/>
    </Style>
    <Style x:Key="LinkHintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,8,0,2"/>
    </Style>
    <!-- 큰 숫자 집계: UDInspect 멀티 스캔 상단(56px) -->
    <Style x:Key="BigCount" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BigCountSize}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="BigCountLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="8,0,28,10"/>
    </Style>
    <!-- 판독값(큰 글씨) -->
    <Style x:Key="ReadoutText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ReadoutSize}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 패널 -->
    <!-- 연파랑 둥근 패널: 현재 선택(국가/규격/양식) 같은 '상태 카드' -->
    <Style x:Key="SoftPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SoftPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SoftPanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
    <!-- 파란 칩: 집계·태그 -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="Margin" Value="0,0,6,2"/>
    </Style>
    <!-- 상태 배지: 크림색 판독값 박스 (UDInspect BarcodeText 박스) -->
    <Style x:Key="BadgeBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ReadoutBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ReadoutBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>
    <!-- 화면 상단 경고 배너: 상태바(시선 밖)만으로는 부족한 알람을 본문 위에 표시 -->
    <Style x:Key="AlertBanner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarnBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="4,2"/>
    </Style>

    <!-- 메인 창 안 오버레이 카드: 딤(#66000000) 위에 뜨는 선택 패널 (별도 창 대신) -->
    <Style x:Key="OverlayCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SoftPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,10,14,12"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 데이터그리드: UDInspect 표 규범 -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLineBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource GridLineBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="RowHeight" Value="24"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
    </Style>
    <!-- 우측 정렬 셀 (숫자 컬럼용) -->
    <Style x:Key="RightCell" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Padding" Value="0,0,6,0"/>
    </Style>
    <Style x:Key="CenterCell" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!-- 규격 선택 토글: UDInspect 선택 카드 상태 (보통=흰 배경 회색 2px / 선택=파랑 테두리 굵게 + 연파랑, 글자색 유지) -->
    <Style x:Key="StandardToggle" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,4,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="2" Padding="9,3"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background"
                                    Value="{StaticResource PrimarySoftBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush"
                                    Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="3"/>
                            <Setter TargetName="border" Property="Padding" Value="8,2"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background"
                                    Value="{StaticResource AccentSoftBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush"
                                    Value="{StaticResource SoftPanelBorderBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="3"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
