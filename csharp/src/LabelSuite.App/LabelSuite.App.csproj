<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AssemblyName>LabelSuite</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <!-- 리눅스 CI에서도 컴파일 검증 가능 (실행은 Windows 전용) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- SkiaSharp 3.119 세대로 통일 (PDFtoImage 5.2.1 / ZXing 0.16.22 / RapidOcrNet 4.0.2) -->
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.22" />
    <!-- RapidOcrNet의 모델 복사 targets는 직접 참조에서만 동작 (엔진 코드는 Core) -->
    <PackageReference Include="RapidOcrNet" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabelSuite.Core\LabelSuite.Core.csproj" />
  </ItemGroup>

</Project>
