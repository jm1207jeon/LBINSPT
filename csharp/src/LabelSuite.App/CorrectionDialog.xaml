<Window x:Class="LabelSuite.App.CorrectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR 오인식 교정" Width="480" Height="420" MinWidth="420" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="교정 등록" Style="{StaticResource PrimaryButton}" MinWidth="90" Click="OnRegister" IsDefault="True"/>
            <Button Content="닫기" MinWidth="70" Click="OnClose" IsCancel="True"/>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="HeaderText" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,8"
                       Text="OCR이 잘못 읽은 단어를 선택하고, 올바른 값을 확인한 뒤 [교정 등록]을 누르세요.&#10;등록된 교정은 저장되어 이후 모든 검사에서 자동 적용되고, 문자 혼동 규칙(예: O↔0)도 함께 학습됩니다."/>
            <GroupBox Header="이 페이지에서 비슷하게 읽힌 단어 (오인식 후보)">
                <ListBox x:Name="CandidateList" Height="160" FontFamily="Consolas"
                         SelectionChanged="OnCandidateSelected"/>
            </GroupBox>
            <TextBlock Text="잘못 읽힌 값 (직접 입력 가능):" Margin="0,8,0,2"/>
            <TextBox x:Name="WrongBox" FontFamily="Consolas"/>
            <TextBlock Text="올바른 값:" Margin="0,8,0,2"/>
            <TextBox x:Name="RightBox" FontFamily="Consolas"/>
        </StackPanel>
    </DockPanel>
</Window>
