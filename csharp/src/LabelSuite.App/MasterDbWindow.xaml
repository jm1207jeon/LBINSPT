<Window x:Class="LabelSuite.App.MasterDbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="라벨 기준정보 DB" Width="860" Height="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="6">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintText}"
                   Margin="2,0,2,6"
                   Text="PN(품목번호)별 기준정보입니다. 검사 목록을 로드하면 자동 축적되며, 여기서 수정한 값이 우선 적용됩니다.&#10;기대 심볼로지: 쉼표 구분 (예: GS1 DataMatrix, GS1-128) — 검사 시 해당 바코드가 검출되지 않으면 '확인 필요'로 표시됩니다."/>
        <!-- 주의 동작(선택 행 삭제)은 왼쪽에 분리, 주 동작(저장)은 오른쪽 파랑 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="닫기" MinWidth="70" Click="OnClose"/>
            <Button DockPanel.Dock="Right" Content="저장" Style="{StaticResource PrimaryButton}" MinWidth="90" Click="OnSave"/>
            <Button DockPanel.Dock="Left" Content="선택 행 삭제" Style="{StaticResource CautionButton}" Click="OnDeleteSelected"
                    ToolTip="선택한 PN 행을 목록에서 지웁니다 — [저장]을 눌러야 확정됩니다"/>
        </DockPanel>
        <DataGrid x:Name="Grid" IsReadOnly="False" CanUserAddRows="True"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PN" Binding="{Binding Pn}" Width="120"/>
                <DataGridTextColumn Header="PRODUCTS" Binding="{Binding Products}" Width="*"/>
                <DataGridTextColumn Header="REF" Binding="{Binding Ref}" Width="130"/>
                <DataGridTextColumn Header="GTIN" Binding="{Binding Gtin}" Width="130"/>
                <DataGridTextColumn Header="기대 심볼로지" Binding="{Binding Symbologies}"
                                    Width="170"/>
                <DataGridTextColumn Header="비고" Binding="{Binding Note}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
