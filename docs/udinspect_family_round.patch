index 0000000..0290588
--- /dev/null
+++ b/docs/LAVIS_FAMILY_ROUND.md
@@ -0,0 +1,16 @@
+# LaVIS 패밀리 역이식 라운드 (2026-09-08)
+
+자매 제품 LaVIS(라벨 OCR·바코드 검사, jm1207jeon/LBINSPT)를 UDInspect 규범으로 정비하는 과정에서
+LaVIS 쪽에 먼저 생긴 장치 중 UDInspect에도 유효한 것을 되가져왔다. 두 제품의 디자인 규범 원문은
+LaVIS 저장소 `docs/family_design.md`(§10 역이식 치환표)이다.
+
+| 항목 | 내용 | 파일 |
+|---|---|---|
+| 패밀리 디자인 토큰 | `Theme.xaml`(LaVIS와 같은 키·값)을 도입하고 MainWindow/SettingsWindow/CountryPicker의 인라인 색 56곳을 `{StaticResource …}`로 치환. PrimaryButton/DangerButton/CautionButton/HintText/SoftPanel/Chip/OverlayCard 스타일 | `Theme.xaml`, `App.xaml`, 3개 XAML |
+| 상태바 경고 고정 | 경고/오류 메시지를 5초간 고정해, 스캔마다 오는 '리딩 완료' 정보 메시지에 덮이지 않게 함 (강건성 리뷰 R5의 최소 형태) | `MainWindow.xaml.cs` `SetStatus` |
+| 프로그램 정보·빌드 식별 | 상태바 `v버전` 클릭 → 메인 창 안 About 오버레이(버전·빌드·.NET·데이터 폴더·로그, Esc/딤 클릭 닫기). CI가 `InformationalVersion`(태그 또는 sha7)을 주입하고 `BUILD_INFO.txt`에 exe SHA-256을 기록, 릴리스 본문에도 표기 — 밸리데이션 문서의 도구 식별란용 | `MainWindow.xaml(.cs)`, `App.xaml.cs`, `.csproj`, `build-windows.yml` |
+| 설정 백업·복원 | 설정 창 하단 [설정 백업…]/[설정 복원…]: settings.json + 기준 정보 캐시를 zip으로. 복원은 기본 '아니오' 확인 → 현재 상태를 `backup-settings-시각`에 보관 → 교체 → 재시작 | `SettingsWindow.xaml(.cs)` |
+| 소스 규약 테스트 | 리소스 키 존재, 팔레트 색 인라인 금지, XAML 이벤트 핸들러 존재, 모달 창 Esc 취소 버튼 — Windows CI에서 실행 | `SourceGuardTests.cs` |
+
+LaVIS에는 있고 UDInspect에는 아직 없는 것(다음 후보): 설정 값 범위표·자동 보정(`SettingRanges/Normalize`),
+CSV 내보내기 공통 보호막(`ExportGuard`), 판정 행 앰버 플래시의 DataGrid 공용 헬퍼(`UiFx`), 규제 위치 한 줄 선언을 About 외 README에도.
diff --git a/src/ZebraScannerSuite.Tests/SourceGuardTests.cs b/src/ZebraScannerSuite.Tests/SourceGuardTests.cs
new file mode 100644
index 0000000..814d47b
--- /dev/null
+++ b/src/ZebraScannerSuite.Tests/SourceGuardTests.cs
@@ -0,0 +1,101 @@
+// 소스 규약 테스트 (LaVIS ThemeTokenTests/AppSourceGuardTests 이식) — WPF 화면 코드는 실기 없이는
+// 잘못된 리소스 키·이벤트 핸들러 누락이 런타임(XamlParseException)에야 드러나므로 소스 수준에서 미리 잡는다.
+using System.Text.RegularExpressions;
+using Xunit;
+
+namespace ZebraScannerSuite.Tests;
+
+public class SourceGuardTests
+{
+    private static string? FindAppDir()
+    {
+        var dir = new DirectoryInfo(AppContext.BaseDirectory);
+        while (dir != null)
+        {
+            string candidate = Path.Combine(dir.FullName, "src", "ZebraScannerSuite");
+            if (File.Exists(Path.Combine(candidate, "Theme.xaml"))) return candidate;
+            dir = dir.Parent;
+        }
+        return null;
+    }
+
+    private static IEnumerable<string> XamlFiles(string appDir) =>
+        Directory.GetFiles(appDir, "*.xaml", SearchOption.TopDirectoryOnly);
+
+    [Fact]
+    public void EveryStaticResourceKeyExistsInThemeOrLocalResources()
+    {
+        string? appDir = FindAppDir();
+        Assert.NotNull(appDir);   // 테스트는 저장소 안에서 실행된다
+        string theme = File.ReadAllText(Path.Combine(appDir!, "Theme.xaml"));
+        var themeKeys = Regex.Matches(theme, "x:Key=\"([^\"]+)\"").Select(m => m.Groups[1].Value).ToHashSet();
+        var missing = new List<string>();
+        foreach (string file in XamlFiles(appDir!).Concat(Directory.GetFiles(appDir!, "*.cs")))
+        {
+            string text = File.ReadAllText(file);
+            var localKeys = Regex.Matches(text, "x:Key=\"([^\"]+)\"").Select(m => m.Groups[1].Value).ToHashSet();
+            var refs = Regex.Matches(text, "\\{StaticResource ([A-Za-z0-9_]+)\\}").Select(m => m.Groups[1].Value)
+                .Concat(Regex.Matches(text, "FindResource\\(\"([A-Za-z0-9_]+)\"\\)").Select(m => m.Groups[1].Value));
+            foreach (string key in refs)
+                if (!themeKeys.Contains(key) && !localKeys.Contains(key))
+                    missing.Add($"{Path.GetFileName(file)}: {key}");
+        }
+        Assert.True(missing.Count == 0, "Theme.xaml에 없는 리소스 키:\n" + string.Join("\n", missing));
+    }
+
+    [Fact]
+    public void FamilyPaletteColorsAreNotInlinedInXaml()
+    {
+        string? appDir = FindAppDir();
+        Assert.NotNull(appDir);
+        // 토큰이 있는 색은 인라인 hex 대신 {StaticResource …}를 써야 LaVIS와 색이 함께 바뀐다
+        string[] tokenized = { "#FF1A6FB5", "#FF1A5276", "#FFF3F6FA", "#FFB9C4D0", "#FFE3F0FB", "#FFFFC7CE", "#FF9C0006",
+                               "#FFD7EFD7", "#FFD9534F", "#FFF0AD4E", "#FFE67E00", "#FFFDF6E3", "#FFBBB69A", "#FF1E1E1E",
+                               "#FF9E9E9E", "#FF666666", "#FFDDDDDD", "#FFB03A2E", "#FFB01E1E", "#66000000" };
+        var offenders = new List<string>();
+        foreach (string file in XamlFiles(appDir!).Where(f => !f.EndsWith("Theme.xaml")))
+        {
+            string text = File.ReadAllText(file);
+            foreach (string hex in tokenized)
+                if (text.Contains($"=\"{hex}\"", StringComparison.OrdinalIgnoreCase))
+                    offenders.Add($"{Path.GetFileName(file)}: {hex}");
+        }
+        Assert.True(offenders.Count == 0, "토큰으로 치환해야 할 인라인 색:\n" + string.Join("\n", offenders));
+    }
+
+    [Fact]
+    public void XamlEventHandlersExistInCodeBehind()
+    {
+        string? appDir = FindAppDir();
+        Assert.NotNull(appDir);
+        var missing = new List<string>();
+        foreach (string xaml in XamlFiles(appDir!))
+        {
+            string cs = xaml + ".cs";
+            if (!File.Exists(cs)) continue;
+            string x = File.ReadAllText(xaml), c = File.ReadAllText(cs);
+            var handlers = Regex.Matches(x,
+                "\\b(?:Click|Checked|Unchecked|SelectionChanged|KeyDown|TextChanged|MouseLeftButtonDown|MouseLeftButtonUp|Loaded|Closing|ScrollChanged|Sorting|PreviewTextInput)=\"(\\w+)\"")
+                .Select(m => m.Groups[1].Value).Distinct();
+            foreach (string h in handlers)
+                if (!Regex.IsMatch(c, "\\bvoid\\s+" + h + "\\s*\\(")) missing.Add($"{Path.GetFileName(xaml)}: {h}");
+        }
+        Assert.True(missing.Count == 0, "코드비하인드에 없는 이벤트 핸들러:\n" + string.Join("\n", missing));
+    }
+
+    [Fact]
+    public void EveryModalWindowHasEscapeCancelButton()
+    {
+        string? appDir = FindAppDir();
+        Assert.NotNull(appDir);
+        var offenders = new List<string>();
+        foreach (string xaml in XamlFiles(appDir!))
+        {
+            string text = File.ReadAllText(xaml);
+            if (!Regex.IsMatch(text, "^\\s*<Window\\b", RegexOptions.Multiline)) continue;
+            if (Path.GetFileName(xaml) == "MainWindow.xaml") continue;
+            if (!text.Contains("IsCancel=\"True\"")) offenders.Add(Path.GetFileName(xaml));
+        }
+        Assert.True(offenders.Count == 0, "Esc(IsCancel) 버튼이 없는 모달 창: " + string.Join(", ", offenders));
+    }
+}
