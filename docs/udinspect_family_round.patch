     // ---------------- 저장 ----------------
 
+    // ==================== 설정 백업 / 복원 (LaVIS 프리셋 규범의 축약형) ====================
+
+    private static readonly string[] BackupFiles = { "settings.json", "pn_reference.csv", "pn_reference.meta.json" };
+
+    private void BackupSettings_Click(object sender, RoutedEventArgs e)
+    {
+        var dlg = new SaveFileDialog
+        {
+            Title = "설정 백업",
+            Filter = "UDInspect 설정 백업 (*.zip)|*.zip",
+            FileName = $"UDInspect-settings_{DateTime.Now:yyyyMMdd-HHmm}.zip",
+        };
+        if (dlg.ShowDialog(this) != true) return;
+        try
+        {
+            if (File.Exists(dlg.FileName)) File.Delete(dlg.FileName);
+            using var zip = System.IO.Compression.ZipFile.Open(dlg.FileName, System.IO.Compression.ZipArchiveMode.Create);
+            int count = 0;
+            foreach (string name in BackupFiles)
+            {
+                string path = Path.Combine(AppPaths.DataDir, name);
+                if (!File.Exists(path)) continue;
+                zip.CreateEntryFromFile(path, name);
+                count++;
+            }
+            SettingsNote.Text = $"백업 완료 ({count}개 파일): {dlg.FileName}";
+            AppLog.Info("설정 백업: " + dlg.FileName);
+        }
+        catch (Exception ex)
+        {
+            SettingsNote.Text = "백업 실패: " + ex.Message;
+            AppLog.Error("설정 백업 실패", ex);
+        }
+    }
+
+    private void RestoreSettings_Click(object sender, RoutedEventArgs e)
+    {
+        var dlg = new OpenFileDialog { Title = "설정 복원", Filter = "UDInspect 설정 백업 (*.zip)|*.zip|모든 파일|*.*" };
+        if (dlg.ShowDialog(this) != true) return;
+        List<string> entries;
+        try
+        {
+            using var probe = System.IO.Compression.ZipFile.OpenRead(dlg.FileName);
+            entries = probe.Entries.Select(x => x.FullName).Where(BackupFiles.Contains).ToList();
+        }
+        catch (Exception ex)
+        {
+            SettingsNote.Text = "백업 파일을 읽을 수 없습니다: " + ex.Message;
+            return;
+        }
+        if (!entries.Contains("settings.json"))
+        {
+            SettingsNote.Text = "UDInspect 설정 백업이 아닙니다 (settings.json 없음).";
+            return;
+        }
+        // 되돌리기 어려운 동작: 내용 표시 + 기본 버튼 '아니오' (스캐너 Enter 오조작 방지)
+        var answer = MessageBox.Show(this,
+            $"백업 파일의 설정({string.Join(", ", entries)})으로 현재 설정을 교체합니다.\n" +
+            "현재 설정은 데이터 폴더의 backup-settings-시각 폴더에 보관됩니다.\n" +
+            "적용을 위해 UDInspect가 다시 시작됩니다. 계속할까요?",
+            "설정 복원", MessageBoxButton.YesNo, MessageBoxImage.Warning, MessageBoxResult.No);
+        if (answer != MessageBoxResult.Yes) return;
+        try
+        {
+            string backupDir = Path.Combine(AppPaths.DataDir, $"backup-settings-{DateTime.Now:yyyyMMdd-HHmmss}");
+            Directory.CreateDirectory(backupDir);
+            foreach (string name in BackupFiles)
+            {
+                string current = Path.Combine(AppPaths.DataDir, name);
+                if (File.Exists(current)) File.Copy(current, Path.Combine(backupDir, name), overwrite: true);
+            }
+            using (var zip = System.IO.Compression.ZipFile.OpenRead(dlg.FileName))
+                foreach (var entry in zip.Entries.Where(x => BackupFiles.Contains(x.FullName)))
+                {
+                    string target = Path.Combine(AppPaths.DataDir, entry.FullName);
+                    entry.ExtractToFile(target + ".tmp", overwrite: true);
+                    File.Move(target + ".tmp", target, overwrite: true);
+                }
+            AppLog.Info($"설정 복원: {dlg.FileName} (이전 상태 {backupDir})");
+            MessageBox.Show(this, $"설정을 복원했습니다. 이전 상태는\n{backupDir}\n에 보관되었습니다.\n\n확인을 누르면 UDInspect가 다시 시작됩니다.",
+                "설정 복원", MessageBoxButton.OK, MessageBoxImage.Information);
+            DialogResult = false;
+            App.Restart();
+        }
+        catch (Exception ex)
+        {
+            SettingsNote.Text = "복원 실패: " + ex.Message;
+            AppLog.Error("설정 복원 실패", ex);
+        }
+    }
+
