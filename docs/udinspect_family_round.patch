+            SHA-256: $hash  (UDInspect.exe)
+          "@ | Out-File -FilePath publish/BUILD_INFO.txt -Encoding utf8BOM
+          "UDInspect.exe SHA-256 = $hash"
+          "sha256=$hash" >> $env:GITHUB_OUTPUT
+
